<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Select2 CSS & JS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<%= render partial: 'products/sub_header' %>
<div class="bg-gray-100 p-6 max-w-3xl mx-auto bg-white shadow-lg rounded-lg p-6">
  <div class="flex flex-row justify-between">
    <h1 class="text-2xl font-semibold mb-4">Team & Collaborators</h1>
    <!-- Modal toggle -->
    <button type="button" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 focus:outline-none" id="openModalBtn">
      Add Collaborator
    </button>
  </div>
  
  <ul class="divide-y divide-gray-200" id="collaboratorsList">
    <% @product.users.each do |user| %>
      <li class="p-4 flex items-center justify-between">
        <div class="flex items-center">
          <h2 class="text-lg font-medium text-gray-900"><%= user.username %></h2>
        </div>
        <!-- Delete icon -->
        <button class="deleteCollaboratorBtn text-red-500 hover:text-red-700" data-user-id="<%= user.id %>" data-product-id="<%= @product.id %>">
          &times;
        </button>
      </li>
    <% end %>
  </ul>
</div>

<!-- Modal backdrop -->
<div id="openModalBtn" class="fixed inset-0 bg-black bg-opacity-50 hidden z-40"></div>

<!-- Modal backdrop with blur -->
<div id="modalBackdrop" class="fixed inset-0 bg-black backdrop-blur bg-white/60 p-8 rounded-xl hidden z-40 transition-all duration-300"></div>

<!-- Modal -->
<div id="modal" class="fixed inset-0 flex items-center justify-center hidden z-50">
  <div class="bg-white rounded-lg shadow-lg w-full max-w-md">
    <!-- Header -->
    <div class="flex justify-between items-center p-4 border-b">
      <h2 class="text-lg font-semibold">Add a collaborator</h2>
      <button id="closeModal" class="text-gray-500 hover:text-gray-700 text-xl">&times;</button>
    </div>
    <!-- Body -->
    <div class="p-4">
      <select id="userSearchSelect" style="width: 100%;" class="w-full">
      <!-- Options will be loaded dynamically -->
    </select>
    </div>
    <!-- Footer -->
    <div class="flex justify-end p-4 border-t">
      <button id="closeModalFooter" class="bg-gray-200 hover:bg-gray-300 px-4 py-2 rounded">Close</button>
      <button data-product-id="<%= @product.id %>" style="margin-left: 10px;" type="button" class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 focus:outline-none" id="addCollaboratorBtn">
        Add Collaborator
      </button>
    </div>
  </div>
</div>

<script>

   $(document).ready(function () {
    $.ajaxSetup({
      headers: {
        'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
      }
    });
    $('#userSearchSelect').select2({
      placeholder: 'Search for a user...',
      minimumInputLength: 1, // Wait for at least 1 character
      ajax: {
        url: '/marketplace/users/search', // Your backend endpoint
        dataType: 'json',
        delay: 250,
        data: function (params) {
          return {
            q: params.term // search query
          };
        },
        processResults: function (data) {
          // Assuming your API returns a JSON array like:
          // [{ id: 1, text: 'john.doe' }, { id: 2, text: 'jane.smith' }]
          return {
            results: data
          };
        },
        cache: true
      }
    });

    $('#addCollaboratorBtn').on('click', function () {
      const selectedUserId = $('#userSearchSelect').val();
      const productId = $(this).data('product-id');

      if (!selectedUserId) {
        alert('Please select a user.');
        return;
    }

      $.ajax({
        url: `/products/${productId}/add_collaborator`,
        method: 'POST',
        data: {
          user_id: selectedUserId
        },
        success: function (response) {

          alert('Collaborator added!');
          // Refresh the page to show the updated list
          window.location.reload();
        },
        error: function (xhr) {
          const message = xhr.responseJSON?.error || 'Something went wrong.';
          alert(message);
        }
      });
    });




    $('.deleteCollaboratorBtn').on('click', function () {
      // Optional confirm before deleting
      if (!confirm('Are you sure you want to remove this collaborator?')) {
        return;
      }
      const userId = $(this).data('user-id');
      const productId = $(this).data('product-id');

      $.ajax({
        url: `/products/${productId}/remove_collaborator`,
        method: 'DELETE',
        data: { user_id: userId },
        success: function (response) {
          alert('Collaborator removed!');
          window.location.reload();
        },
        error: function (xhr) {
          const message = xhr.responseJSON?.error || 'Failed to remove collaborator';
          alert(message);
        }
      });
      });
  });


  const modal = document.getElementById('modal');
  const backdrop = document.getElementById('modalBackdrop');
  const openModal = document.getElementById('openModalBtn');
  const closeModal = document.getElementById('closeModal');
  const closeModalFooter = document.getElementById('closeModalFooter');

  openModal.onclick = () => {
    modal.classList.remove('hidden');
    backdrop.classList.remove('hidden');
  };

  const close = () => {
    modal.classList.add('hidden');
    backdrop.classList.add('hidden');
  };

  closeModal.onclick = close;
  closeModalFooter.onclick = close;
  backdrop.onclick = close;
</script>