<header>
<div class="bg-gray-500 w-full h-fit grid grid-cols-1 md:grid-cols-5 lg:grid-cols-9 py-6 border-b-4 border-black">

	
	<%= link_to marketplace_library_path(@product) do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Product</h2>
	</div>
	<% end %>

	<%= link_to code_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Code</h2>
	</div>
	<% end %>

	<%= link_to commits_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Commits</h2>
	</div>
	<% end %>

	<%= link_to issues_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Issues</h2>
	</div>
	<% end %>

	<%= link_to branches_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Branches</h2>
	</div>
	<% end %>

	<%= link_to pullrequests_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Pull Requests</h2>
	</div>
	<% end %>

	<%= link_to configurations_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Configurations</h2>
	</div>
	<% end %>

	<%= link_to deployments_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Deployments</h2>
	</div>
	<% end %>

	<%= link_to team_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Team</h2>
	</div>
	<% end %>

</div>
</header>




