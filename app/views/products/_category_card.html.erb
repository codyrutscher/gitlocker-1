  <%= link_to marketplace_category_path(category), class: "relative flex h-80 w-56 flex-col overflow-hidden rounded-lg p-6 hover:shadow-[0px_20px_20px_15px_#1158f2] xl:w-auto" do %>
    <span aria-hidden="true" class="absolute inset-0">
      <% if category.image_name.present? %>
        <%= image_tag asset_path("categories/#{category.image_name}"), class: "h-full w-full object-cover object-center", alt: "#{category.image_name} Images" %>
      <% else %>
        <%= image_tag "default-cover.png", class: "h-full w-full object-cover object-center", alt: "Default Cover" %>
      <% end %>
    </span>
    <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-gray-800 opacity-50"></span>
    <span class="relative mt-auto text-center text-xl font-bold text-white"><%= category.name %></span>
  <% end %>

