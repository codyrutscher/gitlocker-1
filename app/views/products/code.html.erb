<%= render partial: 'products/sub_header' %>

    <div class="flex bg-gray-100">
        <main class="flex-1 p-6">
            <h1 class="text-2xl font-bold">Repo Name</h1>
	   <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
      		<h2 class="text-lg font-semibold">Search Repository</h2>
        	<input type="text" placeholder="Search files..." class="w-full p-2 border rounded mt-2">
	    </section>
            <div class="bg-white p-4 rounded shadow mt-4">
                <div class="flex items-center space-x-4 border-b pb-2">
                    <span class="font-semibold">Files</span>
                    <button class="bg-blue-500 text-white px-4 py-1 rounded text-sm">Add File</button>
                    <button class="bg-blue-500 text-white px-4 py-1 rounded text-sm">Add Folder</button>
                </div>
                
                <ul class="mt-4 space-y-2">
                    <li class="flex items-center space-x-2">
                        <span>📁</span>
                        <a href="#" class="text-blue-600 hover:underline">src/</a>
                    </li>
                    <li class="flex items-center space-x-2">
                        <span>📁</span>
                        <a href="#" class="text-blue-600 hover:underline">public/</a>
                    </li>
                    <li class="flex items-center space-x-2">
                        <span>📄</span>
                        <a href="#" class="text-blue-600 hover:underline">index.html</a>
                    </li>
                    <li class="flex items-center space-x-2">
                        <span>📄</span>
                        <a href="#" class="text-blue-600 hover:underline">style.css</a>
                    </li>
                    <li class="flex items-center space-x-2">
                        <span>📄</span>
                        <a href="#" class="text-blue-600 hover:underline">app.js</a>
                    </li>
                </ul>
            </div>
        </main>
    </div>
    <div class="p-6 max-w-3xl mx-auto bg-black text-white rounded-lg shadow-lg p-4 font-mono">
        <div id="terminalOutput" class="h-64 overflow-auto text-green-400 text-sm"></div>
        <div class="flex">
            <span class="text-green-400">$</span>
            <input id="terminalInput" type="text" class="bg-transparent text-white outline-none flex-1 ml-2" autofocus placeholder="Type a command..." onkeydown="handleCommand(event)">
        </div>
    </div>
</body>
