<script src="https://cdn.tailwindcss.com"></script>
<%=
  render BreadcrumbComponent.new(current_user,[
    { text: "Product Market Place", url: marketplace_library_path(@product) }
  ])
%>

<div class="flex justify-between items-center bg-gray-900 px-4 py-3 rounded-lg shadow-lg max-w-2xl mx-auto">
    <input type="text" id='prompt_field' placeholder="Ask AI to build something..." class="bg-transparent flex-1 text-white placeholder-gray-500 focus:outline-none px-3">
    <button id="ai-button" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-1 rounded-lg flex items-center">
        Build It →
    </button>
</div>

<div id='ai_response_section' class="flex justify-between items-center text-black pt-4 max-w-2xl mx-auto">
  <% if @message.present? %>
    <div class="text-black-400"><%= @message %> </div>
  <% end %>
</div>

<div style="padding: 20px;">
  <div id="file-content-display">
    <pre><%= @file_content %></pre> 
    <% if policy(@product).editable? %>
      <button id="edit-button" class="rounded-md bg-blue-500 px-4 py-2 text-sm font-semibold text-white shadow-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2" onclick="toggleEdit()" style="margin-top: 1em;">
        Edit
      </button>
    <% end %>
  </div>

  <div id="file-content-form" style="display: none;">
    <%= form_with url: update_file_content_path(@product, file_name: params[:file_name]), method: :post, local: true do |f| %>
      <div>
        <%= text_area_tag :content, @file_content, rows: 20, style: "width: 100%; border: 1px solid #ccc; padding: 1em;" %>
      </div>
      <input type="hidden" name="id" value="<%= @product.id %>">
      <input type="hidden" name="old_file_content" value="<%= @file_content %>">
      <%= f.label :commit_message %><br />
      <input type="text" name="commit_message" class="w-full" required>
      <div style="margin-top: 1em; display: flex; gap: 10px;">
        <%= submit_tag "Make Commit", class: "rounded-md bg-green-500 px-4 py-2 text-sm font-semibold text-white shadow-md hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2", style: "width: 150px;" %>
        <button type="button" onclick="cancelEdit()" class="rounded-md bg-gray-500 px-4 py-2 text-sm font-semibold text-white shadow-md hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2" style="width: 150px;">
          Cancel
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  function toggleEdit() {
    const displayDiv = document.getElementById('file-content-display');
    const formDiv = document.getElementById('file-content-form');

    displayDiv.style.display = 'none';
    formDiv.style.display = 'block';
  }

  function cancelEdit() {
    const displayDiv = document.getElementById('file-content-display');
    const formDiv = document.getElementById('file-content-form');

    formDiv.style.display = 'none';
    displayDiv.style.display = 'block';
  }
  $('#prompt_field').on('keypress', function (e) {
    if (e.which === 13) {
        e.preventDefault();
        $('#ai-button').click();
    }
  });

  $('#ai-button').on('click', function() {
    $('#ai_response_section').html('<div class="text-black-400">Waiting for AI response.</div>');
    $.ajax({
        url: '<%= build_product_file_from_ai_products_path  %>',
        type: 'POST',
        dataType: 'script',
        data: { 
            prompt: $('#prompt_field').val(),
            file_name: '<%= params[:file_name] %>',
            file_content: `<%= @file_content %>`,
            product_id: `<%= @product.id %>`
        },
        headers: {
            'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content') // Read CSRF token dynamically
        }
    });
  });
</script>
