<%= render partial: 'products/sub_header' %>

<div class="flex flex-col items-center p-6">
        <!-- Header -->
        <header class="w-full max-w-4xl bg-white shadow p-4 rounded-lg flex justify-between items-center">
            <h1 class="text-xl font-bold">Repository Commit History</h1>
            <button class="bg-blue-500 text-white px-4 py-2 rounded">New Commit</button>
        </header>
        
        <!-- Commit List -->
        <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
            <h2 class="text-lg font-semibold">Commit History</h2>
            <% @commits.each do |commit| %>
                <ul class="mt-4 space-y-3">
                    <li class="flex justify-between items-center border-b pb-2">
                        <div>
                            <p class="text-blue-600 font-medium"><%= commit.commit_message %></p>
                            <p class="text-sm text-gray-600">Commit #<%= commit.uuid %> - by <%= commit.user.name %>, <%= time_ago_in_words(commit.created_at) %> ago</p>
                        </div>
                        <span class="text-green-600">✅ Merged</span>
                    </li>
                   
                </ul>
            <% end %>
        </section>
    </div>
