
<body class="bg-gray-100">
<header>
<div class="bg-gray-500 w-full h-fit grid grid-cols-1 md:grid-cols-5 lg:grid-cols-9 py-6 border-b-4 border-black">

	
	<%= link_to marketplace_library_path(@product) do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Product</h2>
	</div>
	<% end %>

	<%= link_to code_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Code</h2>
	</div>
	<% end %>

	<%= link_to commits_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Commits</h2>
	</div>
	<% end %>

	<%= link_to issues_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Issues</h2>
	</div>
	<% end %>

	<%= link_to branches_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Branches</h2>
	</div>
	<% end %>

	<%= link_to pullrequests_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Pull Requests</h2>
	</div>
	<% end %>

	<%= link_to configurations_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Configurations</h2>
	</div>
	<% end %>

	<%= link_to deployments_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Deployments</h2>
	</div>
	<% end %>

	<%= link_to team_path do %>
	<div>
	<h2 class="text-center hover:underline hover:text-white">Team</h2>
	</div>
	<% end %>

</div>
</header>
    <div class="min-h-screen flex flex-col items-center p-6">
        <!-- Header -->
        <header class="w-full max-w-4xl bg-white shadow p-4 rounded-lg flex justify-between items-center">
            <h1 class="text-xl font-bold">Repository Settings</h1>
            <button class="bg-red-500 text-white px-4 py-2 rounded">Delete Repository</button>
        </header>
        
        <!-- General Settings -->
        <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
            <h2 class="text-lg font-semibold">General Settings</h2>
            <input type="text" placeholder="Repository Name" class="w-full p-2 border rounded mt-2">
            <textarea placeholder="Repository Description" class="w-full p-2 border rounded mt-2"></textarea>
            <button class="mt-2 bg-blue-500 text-white px-4 py-2 rounded">Save Changes</button>
        </section>
        
        <!-- Branch Protection -->
        <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
            <h2 class="text-lg font-semibold">Branch Protection</h2>
            <select class="mt-2 w-full p-2 border rounded">
                <option>main</option>
                <option>development</option>
                <option>feature-branch</option>
            </select>
            <button class="mt-2 bg-blue-500 text-white px-4 py-2 rounded">Enable Protection</button>
        </section>
        
        <!-- Webhooks -->
        <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
            <h2 class="text-lg font-semibold">Webhooks</h2>
            <input type="text" placeholder="Webhook URL" class="w-full p-2 border rounded mt-2">
            <button class="mt-2 bg-green-500 text-white px-4 py-2 rounded">Add Webhook</button>
        </section>
        
        <!-- Secrets Management -->
        <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
            <h2 class="text-lg font-semibold">Secrets</h2>
            <input type="text" placeholder="Secret Name" class="w-full p-2 border rounded mt-2">
            <input type="password" placeholder="Secret Value" class="w-full p-2 border rounded mt-2">
            <button class="mt-2 bg-green-500 text-white px-4 py-2 rounded">Add Secret</button>
        </section>
        
        <!-- Collaborators -->
        <section class="w-full max-w-4xl bg-white shadow p-4 mt-6 rounded-lg">
            <h2 class="text-lg font-semibold">Manage Collaborators</h2>
            <input type="email" placeholder="Collaborator Email" class="w-full p-2 border rounded mt-2">
            <button class="mt-2 bg-blue-500 text-white px-4 py-2 rounded">Add Collaborator</button>
        </section>
    </div>
</body>
