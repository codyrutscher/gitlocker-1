<script src="https://cdn.tailwindcss.com"></script>

<%=
  render BreadcrumbComponent.new(current_user,[
    { text: "Create Repository", url: new_product_products_path }
  ])
%>

<div class="bg-white text-white font-sans px-6 pt-6 pb-0">
    <!-- Top Search Bar -->
    <div class="flex justify-between items-center bg-gray-900 px-4 py-3 rounded-lg shadow-lg max-w-2xl mx-auto">
        <input type="text" placeholder="Ask v0 to build something..." class="bg-transparent flex-1 text-white placeholder-gray-500 focus:outline-none px-3">
        <!-- File Attachment Icon -->
        <button class="p-2 rounded hover:bg-gray-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.44 11.05L12 20.49a5.5 5.5 0 0 1-7.78-7.78l7.78-7.78a3.5 3.5 0 0 1 4.95 4.95L9.88 16.95a1.5 1.5 0 1 1-2.12-2.12l6.36-6.36"></path>
            </svg>
        </button>

        <button class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-1 rounded-lg flex items-center">
            Build It →
        </button>
    </div>
    
    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 py-2 max-w-5xl mx-auto">
        <!-- Import Git Repository -->
        <div class="bg-gray-900 p-6 rounded-lg shadow-lg">
            <h4 class="text-xl font-bold">Import Git Repositories</h4>
            <div class="bg-gray-800 p-6 rounded-lg mt-4">
                <p class="text-gray-400 text-sm">Select a Git provider to import an existing project from a Git Repository.</p>
                <button id="github-button" class="block w-full bg-gray-700 hover:bg-gray-600 text-white font-semibold py-2 mt-3 text-center rounded">
                    <%= current_user.token.present? ? 'Continue' : 'Login' %> with GitHub
                </button>
                <%= form_with url: omniauth_authorize_path(User, :github, state: 'import_products'), method: :post, data: { turbo: "false" }, id: "github-auth-form", class: "hidden" do %>
                    <button type="submit"></button>
                <% end %>

                <button id="gitlab-button" class="block w-full bg-purple-600 hover:bg-purple-500 text-white font-semibold py-2 mt-3 text-center rounded">
                    <%= current_user.gitlab_token.present? ? 'Continue' : 'Login' %> with GitLab
                </button>
                <%= form_with url: omniauth_authorize_path(User, :gitlab, state: 'import_products'), method: :post, data: { turbo: "false" }, id: "gitlab-auth-form", class: "hidden" do %>
                    <button type="submit"></button>
                <% end %>

                <a href="#" class="block w-full bg-blue-700 hover:bg-blue-400 text-white font-semibold py-2 mt-3 text-center rounded">Continue with Bitbucket</a>
                <a href="<%= new_product_path %>" class="block mt-4 text-gray-300 hover:text-white text-sm js-manual-upload-file">Manually Upload Zip File →</a>
            </div>
        </div>
        
        <!-- Clone Template -->
        <div class="bg-gray-900 p-6 rounded-lg shadow-lg">
            <div class="flex justify-between items-center">
                <h4 class="text-xl font-bold">Clone Template</h4>
                <span class="text-gray-400">Framework ▼</span>
            </div>
            <div class="grid grid-cols-2 gap-4 mt-4">
                <% @templates.each do |template| %>
                    <div class="bg-gray-800 p-4 rounded-lg text-center">
                        <%= link_to template_path(template), class: "block bg-gray-800 p-4 rounded-lg text-center hover:bg-gray-700" do %>
                            <p class="text-white"><%= template.name %></p>
                        <% end %>                        
                    </div>
                <% end %>
            </div>
            <a href="<%= templates_path %>" class="block mt-4 text-gray-300 hover:text-white text-sm">Browse All Templates →</a>
        </div>
    </div>
    <!-- Display GitHub Repositories -->
    <div id="repos-section" class="hidden py-0">
        <% if @user_repos.present? %>
            <h1 class="text-2xl font-bold mb-4">Select GitHub Repositories to Add as Products</h1>
                <div id="github_repos" class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <% @user_repos.each do |repo| %>
                        <div class="bg-gray-900 p-6 rounded-lg shadow-lg">
                            <h4 class="text-xl font-bold"><%= repo[:name] %></h4>
                            <p class="text-gray-400 text-sm"><%= repo[:description] %></p>
                            <label class="block mt-4">
                                <%= check_box_tag 'repo_ids[]', repo[:id], false, class: 'mr-2 js-github-repo-ids' %>
                                Select this repository
                            </label>
                        </div>
                    <% end %>
                </div>
                <!-- Pagination Controls -->
                <div class="mt-6 flex justify-between items-center">
                    <% if @display_next_page_link %>
                        <div class="flex items-center gap-4" id="load_more_repos_button">
                            <%= link_to 'See More Repos', load_more_github_repos_products_path, data: { page: (@github_page + 1) }, id: 'load-more-repos', class: 'bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded disabled:opacity-50' %>
                        </div>
                    <% end %>
                </div>
        <% end %>
    </div>
    <!-- Display GitLab Repositories -->
    <div id="gitlab-repos-section" class="hidden py-0">
        <% if @gitlab_repos.present? %>
            <h1 class="text-2xl font-bold mb-4">Select GitLab Repositories to Add as Products</h1>
                <div id="gitlab_repos" class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <% @gitlab_repos.each do |repo| %>
                        <div class="bg-gray-900 p-6 rounded-lg shadow-lg">
                            <h4 class="text-xl font-bold"><%= repo['name'] %></h4>
                            <p class="text-gray-400 text-sm"><%= repo['description'] %></p>
                            <label class="block mt-4">
                                <%= check_box_tag 'repo_ids[]', repo['id'], false, class: 'mr-2 js-gitlab-repo-ids' %>
                                Select this repository
                            </label>
                        </div>
                    <% end %>
                </div>
                <div class="mt-6 flex justify-between items-center">
                    <% if @display_next_page_link_gitlab %>
                        <div class="flex items-center gap-4" id="load_more_gitlab_repos_button">
                            <%= link_to 'See More Repos', load_more_gitlab_repos_products_path, data: { page: (@gitlab_page + 1) }, id: 'load-more-gitlab-repos', class: 'bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded disabled:opacity-50' %>
                        </div>
                    <% end %>
                </div>
        <% end %>
    </div>
    <div class="hidden js-new-product py-0">
        <%= render partial: 'products/new_product_form', locals: { import_product: false } %>
    </div>
    <div class="hidden js-import-product py-0">
        <%= render partial: 'products/import_product_form', locals: { import_product: true } %>
    </div>
</div>

<script>
    $('#github-button').on('click', function() {
        event.preventDefault();
        <% if current_user.token.present? %>
            $('#repos-section').show();
            $('#gitlab-repos-section').css('display', 'none');
            $('.js-new-product').css('display', 'none');
            $('.js-import-product').show();
            $('#source_value').val('github');
        <% else %>
            document.getElementById('github-auth-form').querySelector('button').click();
        <% end %>
    });

    $('#gitlab-button').on('click', function() {
        event.preventDefault();
        <% if current_user.gitlab_token.present? %>
            $('#repos-section').css('display', 'none');
            $('#gitlab-repos-section').show();
            $('.js-new-product').css('display', 'none');
            $('.js-import-product').show();
            $('#source_value').val('gitlab');
        <% else %>
            document.getElementById('gitlab-auth-form').querySelector('button').click();
        <% end %>
    });
    $('.js-manual-upload-file').on('click', function(event) {
        event.preventDefault();
        $('.js-new-product').show();
        $('.js-import-product').css('display', 'none');
        $('#repos-section').css('display', 'none');
        $('#gitlab-repos-section').css('display', 'none');
        $('#source_value').val('manual');
    });
    $('#load-more-repos').on('click', function(event) {
        event.preventDefault();
        $.ajax({
            url: $(this).attr('href'),
            type: 'GET',
            dataType: 'script',
            data: { page: $(this).data('page') }
        });
    });
    
    $('#load-more-gitlab-repos').on('click', function(event) {
        event.preventDefault();
        $.ajax({
            url: $(this).attr('href'),
            type: 'GET',
            dataType: 'script',
            data: { page: $(this).data('page') }
        });
    });

</script>
