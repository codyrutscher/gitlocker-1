<%= content_for :meta_title, "GitLocker Featured Categories" %>
<%= content_for :meta_description, "Browse through community favorites on GitLocker. Find the most loved and highly rated projects endorsed by fellow developers." %>

<div class="bg-white">
  <%= render BreadcrumbComponent.new(current_user, [{ text: "Featured", url: marketplace_browse_featured_path }]) %>
   <main>
    <section aria-labelledby="category-heading" class="sm:py-8">
      <div class="sm:flex sm:items-center justify-center sm:px-6">
        <h1 id="category-heading" class="text-xl sm:text-2xl font-bold text-center tracking-tight text-gray-900 underline">Browse By Featured Repositories</h1>
      </div>
      <hr class="h-px bg-black border-4 border-black">
      
    <div class="bg-gray-300">
      <!-- Filter Form -->
      <%= render partial: 'shared/productFilter' %>
    </div>
  <hr class="h-px bg-black border-4 mb-4 border-black">
      <div class="mt-4 flow-root">

        <div class="">
          <div class="">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7">
              <%= render partial: "home/product", collection: @products %>
            </div>
          </div>
        </div>
      </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
      <div class="mt-4 px-4 sm:px-6 lg:px-8 space-y-8">
        <%= render 'kaminari/tailwind/paginator', paginator: @products %>
      </div>
    </section>
  </main>
</div>
