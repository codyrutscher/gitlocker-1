<% if params[:page].present? %>
  <%= content_for :meta_title, "GitLocker Categories Page #{params[:page]}" %>
  <%= content_for :meta_description, "Browse GitLocker's marketplace for free and premium resources. Find everything you need to elevate your coding projects Pages-#{params[:page]}" %>
<% else %>
  <%= content_for :meta_title, "GitLocker Categories" %>
  <%= content_for :meta_description, "Browse GitLocker's marketplace for free and premium resources. Find everything you need to elevate your coding projects" %>
<% end %>

<%=
  render BreadcrumbComponent.new(current_user,[
    { text: "Categories", url: marketplace_browse_categories_path }
  ])
%>

<section aria-labelledby="category-heading" class="pt-16 pb-24 sm:pt-16 bg-white">
  <div class="">
    <div class="px-8 py-4 ">
      <h1 class="text-3xl font-semibold mb-4 text-center underline">Categories</h1>
    </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <div class="py-4 xl:px-0 lg:px-8 sm:px-6 px-4 mb-4 ">
      <!-- Filter Form -->
      <%= render partial: 'shared/categoryFilter' %>
    </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <% if @categories.count > 0 %>
      <div class="flow-root">
        <div class=" flex grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-7 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
          <%= render partial: "home/category", collection: @categories %>
        </div>
      </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
      <div class="mt-12">
        <!-- Pagination with sort_by parameter -->
        <%= render 'kaminari/tailwind/paginator', paginator: @categories, params: { sort_by: params[:sort_by] } %>
      </div>
    <% end %>
  </div>
</section>
