<%= content_for :meta_title, "GitLocker Recent Repositories" %>
<%= content_for :meta_description, "Stay updated with the latest additions on GitLocker. Browse through the most recent repositories and projects to find fresh and innovative code ready for exploration and collaboration." %>


<div class="bg-white">
  <%= render BreadcrumbComponent.new(current_user, [{ text: "Recent", url: marketplace_browse_recent_path }]) %>
  <main>
    <section aria-labelledby="category-heading" class="py-8 sm:py-8 xl:py-8 xl:mx-auto xl:px-8">
      <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0 mb-4">
        <h1 id="category-heading" class="text-xl sm:text-2xl font-bold  tracking-tight text-gray-900 underline">Browse By Recent Repositories</h1>
      </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <div class="px-8 py-4 ">
    <!-- Filter Form -->
    <%= render partial: 'shared/productFilter' %>
  </div>
<hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
     <div class="mt-4 flow-root">
        <div class="">
          <div class="">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7">
              <%= render partial: "home/product", collection: @products %>
            </div>
          </div>
        </div>
      </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
      <div class="mt-4 px-4 sm:px-6 lg:px-8 space-y-8">
        <%= render 'kaminari/tailwind/paginator', paginator: @products %>
      </div>
    </section>
  </main>
</div>
