<%= content_for :meta_title, "GitLocker Free Categories" %>
<%= content_for :meta_description, "Access a vast collection of free code repositories on GitLocker. Find quality projects to contribute to or use as the foundation for your own development" %>

<div class="bg-white">
  <%= render BreadcrumbComponent.new(current_user, [{ text: "Free", url: marketplace_browse_free_path }]) %>
  <main>
    <section aria-labelledby="category-heading" class="sm:py-8">
     <div class="sm:flex sm:items-center justify-center align-center sm:px-6">
        <h1 id="category-heading" class="text-xl sm:text-2xl align-center font-bold text-center tracking-tight text-gray-900 underline">Browse By Free Repositories</h1>
      </div>
      <hr class="h-px bg-black mb-4 border-4 border-black">
      
    <div class="bg-white">
      <!-- Filter Form -->
      <%= render partial: 'shared/productFilter' %>
    </div>
  <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
     <div class="mt-4 flow-root">
        <div class="">
          <div class="px-8">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
              <%= render partial: "home/product", collection: @products %>
            </div>
          </div>
        </div>
      </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
      <div class="mt-4 px-4 sm:px-6 lg:px-8 space-y-8">
        <%= render 'kaminari/tailwind/paginator', paginator: @products %>
      </div>
    </section>
  </main>
</div>
