<%= content_for :meta_title, "GitLocker Languages Categories" %>
<%= content_for :meta_description, "Explore GitLocker's language-specific repositories in our marketplace. Easily find and browse projects tailored to your preferred programming language, from JavaScript to Python and beyond." %>

<%=
  render BreadcrumbComponent.new(current_user, [
    { text: "Languages", url: marketplace_browse_languages_path }
  ])
%>

<section aria-labelledby="category-heading" class="pt-16 pb-24 sm:pt-16 bg-white">
  <div class="xl:mx-auto xl:px-8">
    <div class="px-8 py-4 ">
    <h1 class="text-3xl font-semibold mb-4 text-center  underline">Languages</h1>
    </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <div class="py-4 mb-4">
      <!-- Filter Form -->
      <%= render partial: 'shared/categoryFilter' %>
    </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <% if @languages.count > 0 %>
      <div class="flow-root">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
          <%= render partial: "home/language", collection: @languages, as: :language %>
        </div>
      </div>
      <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
      <div class="mt-12">
        <!-- Pagination with sort_by parameter -->
        <%= render 'kaminari/tailwind/paginator', paginator: @languages, params: { sort_by: params[:sort_by] } %>
      </div>
    <% end %>
  </div>
</section>
