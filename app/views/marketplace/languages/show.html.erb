<% content_for :meta_title, "GitLocker | #{@language&.name&.titleize} Language" %>
<% content_for :meta_description,  "Find your #{@language&.name&.titleize} class in Gitlocker" %>
<div class="bg-white">
  <%=
    render BreadcrumbComponent.new(current_user,[
      { text: "Languages", url: marketplace_browse_languages_path },
      { text: @language.name, url: marketplace_language_path(@language) }
    ])
  %>
  <main>
    <section aria-labelledby="category-heading" class="py-16 sm:py-16 xl:mx-auto">
      <h1 class="text-3xl font-semibold mb-4 text-center underline "><span class="italic text-orange-500"><%= @language.products.count %></span> <%= @language.name %> Language Products</h1>
      <div class="bg-gradient-to-r from-blue-700 to-orange-500">
      <%= image_tag("languages/#{@language.image_name}", class: "h-96 w-96 object-cover object-center mx-auto", alt: "#{@language.image_name} Images") %>
    </div>
      <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
      <div class="mt-4 px-8 flow-root">
        <div class="-my-2">
          <div class="relative box-content overflow-x-auto py-2 xl:overflow-visible">
            <% if @products.any? %>
              <h2 class="text-3xl font-semibold mb-4 text-center underline">List of Products</h2>
              <div class="pb-6">
              <%= render partial: 'shared/productFilter' %>
              </div>
              <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
              <div class="mt-4 gap-4 sm:grid-cols-2 grid xl:grid-cols-7 lg:grid-cols-4 md:grid-cols-3 xl:gap-x-8">
                <% @products.each do |product| %>
                  <%= render partial: "home/product", locals: { product: product } %>
                <% end %>
              </div>
              <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
            <% else %>
              <p class="text-center text-black">No products available for this language.</p>
            <% end %>
          </div>
          <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
          <div class="<%= 'mt-12' if @products.count > 50 %>">
            <!-- Pagination with sort_by parameter -->
            <%= render 'kaminari/tailwind/paginator', paginator: @products, params: { sort_by: params[:sort_by] } %>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
