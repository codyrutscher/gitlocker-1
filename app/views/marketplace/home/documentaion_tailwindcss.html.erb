              <li><code class="text-sm bg-gray-100 p-1 rounded">rounded-lg</code>: Large border radius</li>
              <li><code class="text-sm bg-gray-100 p-1 rounded">shadow-md</code>: Medium shadow</li>
              <li><code class="text-sm bg-gray-100 p-1 rounded">hover:shadow-lg</code>: Large shadow on hover</li>
            </ul>
