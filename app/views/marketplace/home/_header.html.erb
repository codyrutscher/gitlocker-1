<html>
<head>
<style>
#javascript {
  background-color: #f1e05a;
}
#ruby {
  background-color: #701516;
}
#css {
  background-color: #563d7c;
}
#html {
  background-color: #e34c26;
}
#php {
  background-color: #4F5D95;
}
#python {
  background-color: #3572A;
}
#div {
  display: inline-block
}
#grad {
  background-image: radial-gradient(circle, blue, DodgerBlue, orange);
}




</style>
</head>
<section id="grad" class="relative block  border-b-12 border-t-12 border-black">
  <!-- Carousel Background -->
  <div class="absolute inset-0 z-0 h-full w-full flex">
    
  </div>

