                <%= link_to marketplace_browse_premium_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" do %>
                  <h2><%= Product.where("price_cents > 0").count %> Premium Products</h2>
