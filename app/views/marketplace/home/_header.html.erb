<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    /* Reset and basic styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Poppins', sans-serif;
    }
    
    /* Main container for the header */
    .halftone-header {
      width: 100%;
      min-height: 100vh; /* Full viewport height */
      display: flex;
      justify-content: center;
      align-items: center;
      background-color: black;
      position: relative;
      padding: 40px 0;
    }
    
    #halftoneCanvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    
    .content-container {
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 90%;
      max-width: 1200px;
      gap: 20px;
      margin: 0 auto;
    }
    
    .text-overlay {
      text-align: center;
      color: white;
      padding: 20px; 
      background-color: #000000;
      border-radius: 10px;
      width: 100%;
    }
    
    .text-overlay h1 {
      font-size: 2.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      line-height: 1.3;
    }
    
    .gradient-underline {
      position: relative;
      white-space: nowrap;
    }
    
    .gradient-underline::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #ff6b6b, #4ecdc4, #7f50ff);
      border-radius: 1.5px;
    }
    
    .italic-text {
      font-style: italic;
      font-weight: 400;
    }
    
    .dashboard-image-container {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    
    .dashboard-image {
      width: 100%;
      max-width: 800px; /* Control maximum width */
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      transition: transform 0.3s ease;
    }
    
    .dashboard-image:hover {
      transform: translateY(-5px);
    }
    
    .button-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      width: 100%;
    }
    
    .button-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      width: 100%;
    }
    
    .custom-button {
      display: inline-block;
      background-color: white;
      color: black;
      border: 4px solid black;
      font-weight: bold;
      padding: 8px 16px;
      text-align: center;
      text-decoration: none;
      transition: box-shadow 700ms, color 400ms;
    }
    
    .custom-button:hover {
      box-shadow: inset 30rem 0 0 0 #3b82f6; /* blue-700 */
      color: white;
    }
    
    @media (max-width: 768px) {
      .text-overlay h1 {
        font-size: 1.8rem;
      }
      .content-container {
        gap: 15px;
      }
      .custom-button {
        padding: 8px 12px;
        font-size: 13px;
      }
    }
    
    @media (max-width: 480px) {
      .halftone-header {
        padding: 30px 0;
      }
      .text-overlay h1 {
        font-size: 1.4rem;
      }
      .gradient-underline::after {
        height: 2px;
        bottom: -1px;
      }
      .content-container {
        gap: 10px;
      }
      .button-container {
        width: 100%;
      }
      .button-row {
        flex-direction: column;
        width: 100%;
      }
      .custom-button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="halftone-header">
    <canvas id="halftoneCanvas"></canvas>
    
    <div class="content-container">
      <div class="text-overlay">
        <h1>Your All-In-One Version Control Marketplace with <span class="gradient-underline">AI commits</span>! Browse 100,000+ Projects From 1000+ Developers Or Post Your Code To Start <span class="italic-text">Managing, Deploying and Earning!</span></h1>
      </div>
      
      <div class="button-container">
        <div>
          <a href="/users/sign_in" class="custom-button">Sign In</a>
        </div>
        <div>
          <a href="/users/sign_up" class="custom-button">Create An Account</a>
        </div>
        <div>
          <a href="/marketplace/browse" class="custom-button">
            <h2>Browse</h2>
          </a>
          <a href="/marketplace/creators" class="custom-button">
            <h2>Developers</h2>
          </a>
        </div>
      </div>
      
      <div class="dashboard-image-container">
        <img 
          src="https://sjc.microlink.io/9Zod8AawqkU_Bu0heJI11BIkYtNEuGLCUeGVToSTTT5qYGdTKTHa1gxtvOKvjJwtZ7LLeXkR3V3LMd9wKnmTUA.jpeg" 
          alt="Project management dashboard interface" 
          class="dashboard-image" 
          loading="lazy"
          crossorigin="anonymous"
        />
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const canvas = document.getElementById('halftoneCanvas');
      const ctx = canvas.getContext('2d');
      
      let animationFrameId;
      let time = 0;
      
      function resizeCanvas() {
        // Size canvas to its parent container to ensure full coverage
        const header = canvas.parentElement;
        canvas.width = header.offsetWidth;
        canvas.height = header.offsetHeight;
        console.log(`Canvas resized to ${canvas.width}x${canvas.height}`);
      }
      
      function drawHalftoneWave() {
        const gridSize = 20;
        const rows = Math.ceil(canvas.height / gridSize) + 1; // Add extra row to ensure full coverage
        const cols = Math.ceil(canvas.width / gridSize) + 1; // Add extra column to ensure full coverage
        
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const centerX = x * gridSize;
            const centerY = y * gridSize;
            const distanceFromCenter = Math.sqrt(
              Math.pow(centerX - canvas.width / 2, 2) + 
              Math.pow(centerY - canvas.height / 2, 2)
            );
            const maxDistance = Math.sqrt(
              Math.pow(canvas.width / 2, 2) + 
              Math.pow(canvas.height / 2, 2)
            );
            const normalizedDistance = distanceFromCenter / maxDistance;
            
            const waveOffset = Math.sin(normalizedDistance * 10 - time) * 0.5 + 0.5;
            const size = gridSize * waveOffset * 0.8;
            
            ctx.beginPath();
            ctx.arc(centerX, centerY, size / 2, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${waveOffset * 0.5})`;
            ctx.fill();
          }
        }
      }
      
      function animate() {
        // Fill with semi-transparent black for trail effect
        ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        drawHalftoneWave();
        
        time += 0.05;
        animationFrameId = requestAnimationFrame(animate);
      }
      
      // Initialize
      resizeCanvas();
      window.addEventListener('resize', () => {
        resizeCanvas();
      });
      
      // Start animation
      animate();
    });
  </script>
</body>
</html>
