<html>
<head>
<style>
#javascript {
  background-color: #f1e05a;
}
#ruby {
  background-color: #701516;
}
#css {
  background-color: #563d7c;
}
#html {
  background-color: #e34c26;
}
#php {
  background-color: #4F5D95;
}
#python {
  background-color: #3572A;
}





</style>
</head>
<section class="relative block homepage-section border-b-12 border-t-12 border-black">
  <!-- Carousel Background -->
  <div class="absolute inset-0 z-0 h-full w-full flex">
    <%= image_tag "header/banner-01.jpg", class: "w-screen object-contain", alt: "Gitlocker Header Banner" %>
  </div>

  <!-- Section Content -->
  <div class="relative container mx-auto px-4 text-center text-white py-16 rounded-3xl">
        <h1 class="text-white text-5xl max-w-4xl mx-auto text-balance">
          Browse <span class="font-bold">GitLocker's</span> selection of <span id="count" data-target="100000" class="font-bold italic text-orange-500 underline underline-offset-3 decoration-6 decoration-orange-500">100,000</span> free and premium code products<span class="font-bold italic text-orange-500 underline underline-offset-3 decoration-6 decoration-orange-500"></span> or sign up to start <span class="font-bold">buying and selling</span>! 
        </h1>
   


    <div class="mt-8 space-x-4">
      <% if user_signed_in? %>
        <%= link_to "Browse Creators", marketplace_creators_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <%= link_to "Browse Free Code", marketplace_browse_free_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <%= link_to "Browse Premium Code", marketplace_browse_premium_path, class: "inline-block bg-white hover:shadow-[inset_15rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <%= link_to "Sell Code", new_product_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <%= link_to "Get Paid", funds_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <%= link_to "Create An Account", new_user_registration_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <%= link_to "Browse", marketplace_browse_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
      <% end %>
    </div>

    <div class="mt-8 flex justify-center space-x-4">
      <%= link_to "JavaScript", '/marketplace/languages/javascript', id: "javascript", class: "hover:scale-110 text-black hover:text-black focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg border-black border-4 text-sm px-5 py-2.5 text-center me-2 mb-2" %>
      <%= link_to "Ruby", '/marketplace/languages/ruby', id: "ruby", class: "hover:scale-110 text-black hover:text-black focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 py-2.5 border-black border-4 text-center me-2 mb-2" %>
      <%= link_to "HTML", '/marketplace/languages/html', id: "html", class: "hover:scale-110 text-black hover:text-black focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 py-2.5 border-black border-4 text-center me-2 mb-2" %>
      <%= link_to "CSS", '/marketplace/languages/css', id: "css", class: "hover:scale-110 text-black hover:text-black bg-orange-500 hover:bg-blue-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 py-2.5 border-black border-4 text-center me-2 mb-2" %>
      <%= link_to "PHP", '/marketplace/languages/php', id: "php", class: "hover:scale-110 text-black hover:text-black bg-orange-500 hover:bg-blue-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 py-2.5 border-black border-4 text-center me-2 mb-2" %>
    </div>

     <div class="mt-8 flex justify-center space-x-4">
      <%= link_to "React", '/marketplace/categories/react', class: "hover:scale-110 text-black hover:text-black bg-blue-500 hover:bg-orange-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 border-black border-4 mb-2" %>
      <%= link_to "Next.js", '/marketplace/categories/next-js', class: "hover:scale-110 text-black hover:text-black bg-blue-500 hover:bg-orange-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm border-black border-4 px-5 py-2.5 text-center me-2 mb-2" %>
      <%= link_to "Rails", '/marketplace/categories/rails', class: "hover:scale-110 text-black hover:text-black bg-blue-500 hover:bg-orange-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 border-black border-4 py-2.5 text-center me-2 mb-2" %>
      <%= link_to "Wordpress", '/marketplace/categories/wordpress', class: "hover:scale-110 text-black hover:text-black bg-blue-500 hover:bg-orange-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm border-black border-4 px-5 py-2.5 text-center me-2 mb-2" %>
      <%= link_to "AI", '/marketplace/categories/ai', class: "hover:scale-110 text-black hover:text-black bg-blue-500 hover:bg-orange-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 py-2.5 border-black border-4 text-center me-2 mb-2" %>
      <%= link_to "Mobile", '/marketplace/categories/mobile', class: "hover:scale-110 text-black hover:text-black bg-blue-500 hover:bg-orange-500 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-sm px-5 border-black border-4 py-2.5 text-center me-2 mb-2" %>
    </div>

      <div class="mt-8 flex justify-center space-x-4">
      <%= link_to "Featured Products", marketplace_browse_featured_path, class: "hover:scale-110 text-white rounded-3xl bg-gradient-to-r from-green-400 via-green-500 to-green-600 focus:ring-4 focus:outline-none focus:ring-green-300 dark:focus:ring-green-800 shadow-lg shadow-green-500/50 dark:shadow-lg dark:shadow-green-800/80 font-medium rounded-lg text-xl px-10 py-5 text-center me-2 border-black border-4 mb-2" %>
      </div>

      <div class="mt-8 flex justify-center space-x-4">
        <% if user_signed_in? %>
            <%= link_to "My Listed Products", products_path, class: "inline-block bg-white hover:shadow-[inset_16rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
            <%= link_to "My Purchased Products", marketplace_purchases_path, class: "inline-block bg-white hover:shadow-[inset_16rem_0_0_0] hover:shadow-orange-500 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
        <% end %>
      </div>
  </div>
</section>
</html>
