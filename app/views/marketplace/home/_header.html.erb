<html>
<head>
<style>
#javascript {
  background-color: #f1e05a;
}
#ruby {
  background-color: #701516;
}
#css {
  background-color: #563d7c;
}
#html {
  background-color: #e34c26;
}
#php {
  background-color: #4F5D95;
}
#python {
  background-color: #3572A;
}
#div {
  
}
/* #grad {
  background-image: radial-gradient(circle, blue, DodgerBlue, orange);
} */

#grad {
  background-image: url("https://gitlocker.s3.us-east-2.amazonaws.com/original-4c3fd5c6563b9572a50a8a7936b203ce.webp");
  background-size: cover;
  backdrop-filter: blur(4px);
}




</style>
</head>
<div class="bg-white">
  <div class="relative isolate overflow-hidden bg-gradient-to-b from-indigo-100/20">
    <div class="mx-auto max-w-7xl pb-24 pt-10 sm:pb-32 lg:grid lg:grid-cols-2 lg:gap-x-8 lg:px-8 lg:py-40">
      <div class="px-6 lg:px-0 lg:pt-4">
        <div class="mx-auto max-w-2xl">
          <div class="max-w-lg">
            <img class="h-24" src="https://gitlocker.s3.us-east-2.amazonaws.com/FullLogo_Transparent+(1).png" alt="Your Company">
            <h1 class="mt-10 text-pretty text-5xl font-semibold tracking-tight text-gray-900 underline sm:text-7xl">GitLocker</h1>
            <p class="mt-8 text-pretty text-lg font-medium text-gray-500 sm:text-xl/8">Browse <span class="font-bold">GitLocker's</span> selection of <span class="bg-blue-100 text-blue-800 font-semibold text-4xl px-2.5 py-0.5 rounded dark:bg-blue-200 dark:text-blue-800"><%= number_with_delimiter(Product.count, :delimiter => ',') %></span> free and premium code products or sign up to start <span class="font-bold">buying and selling</span>!</p>
            <div class="mt-10 flex items-center gap-x-6">
              <% if user_signed_in? %>
                <%= link_to "Browse Premium Code", marketplace_browse_premium_path, class: "inline-block bg-white hover:shadow-[inset_15rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
                <%= link_to "Sell Code", new_product_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
                <%= link_to "Get Paid", funds_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
              <% else %>
                <%= link_to "Sign In", new_user_session_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
                <%= link_to "Create An Account", new_user_registration_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
                <%= link_to "Browse", marketplace_browse_path, class: "inline-block bg-white hover:shadow-[inset_12rem_0_0_0] hover:shadow-blue-700 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-20 sm:mt-24 md:mx-auto md:max-w-2xl lg:mx-0 lg:mt-0 lg:w-screen">
        <div class="absolute inset-y-0 right-1/2 -z-10 -mr-10 w-[200%] skew-x-[-30deg] bg-white shadow-xl shadow-indigo-600/10 ring-1 ring-indigo-50 md:-mr-20 lg:-mr-36" aria-hidden="true"></div>
        <div class="shadow-lg md:rounded-3xl">
          <div class="bg-indigo-500 [clip-path:inset(0)] md:[clip-path:inset(0_round_theme(borderRadius.3xl))]">
            <div class="absolute -inset-y-px left-1/2 -z-10 ml-10 w-[200%] skew-x-[-30deg] bg-indigo-100 opacity-20 ring-1 ring-inset ring-white md:ml-20 lg:ml-36" aria-hidden="true"></div>
            <div class="relative px-6 pt-8 sm:pt-16 md:pl-16 md:pr-0">
              <div class="mx-auto max-w-2xl md:mx-0 md:max-w-none">
                <div class="w-screen overflow-hidden rounded-tl-xl bg-gray-900">
                  <div class="flex bg-gray-800/40 ring-1 ring-white/5">
                    <div class="-mb-px flex text-sm/6 font-medium text-gray-400">
                      <div class="border-b border-r border-b-white/20 border-r-white/10 bg-white/5 px-4 py-2 text-white">Styles.css</div>
                      <div class="border-r border-gray-600/10 px-4 py-2">Index.html</div>
                    </div>
                  </div>
                  <div class="px-6 pb-14 pt-6">
			<pre><code class="language-html text-white">&lt;article class="prose"&gt;
  				&lt;h1&gt;Garlic bread with cheese: What the science tells us&lt;/h1&gt;
  				&lt;p&gt;
   					 For years parents have espoused the health benefits of eating garlic bread with cheese to their
    					children, with the food earning such an iconic status in our culture that kids will often dress
    					up as warm, cheesy loaf for Halloween.
  				&lt;/p&gt;
  				&lt;p&gt;
   					 But a recent study shows that the celebrated appetizer may be linked to a series of rabies cases
    					springing up around the country.
  				&lt;/p&gt;
  				&lt;!-- ... --&gt;
				&lt;/article&gt;
			</code></pre>
                  </div>
                </div>
              </div>
              <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-black/10 md:rounded-3xl" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-24 bg-gradient-to-t from-white sm:h-32"></div>
  </div>
</div>

</html>
