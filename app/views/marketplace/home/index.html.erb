<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Page</title>
  <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.css" rel="stylesheet">
</head>
<body>
  <%= render 'header' %>
  
  <!-- Home Content -->
  <div class="bg-white">
    <main class="pb-24">

      <% if @featured_products.size > 0 %>
        <!-- Recent Section -->
        <section aria-labelledby="recent-heading" class="bg-orange-400 border-t-4 border-black">
          <div class=" px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="recent-heading" class="text-3xl font-bold tracking-tight text-black underline"><span class=""><%= @featured_products.count %></span> Featured Products:</h2>
            <button class="bg-white text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full hover:shadow-[inset_24rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow]">
            <%= link_to marketplace_browse_featured_path, class: "link" do %>
              Browse All Featured Repositories
              <span aria-hidden="true">&rarr;</span>
            <% end %>
            </button>
          </div>
      </section>
    <hr class="h-px bg-black border-8 border-black">

     <div class="mt-6 overflow-hidden">
          <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/product", collection: @featured_products %>
            </div>
        </div>

        
      <% end %>
      <hr class="h-px mt-8 bg-black border-8 border-black">


      <% if @recent_products.size > 0 %>
        <!-- Recent Section -->
        <section aria-labelledby="recent-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="recent-heading" class="text-3xl font-bold tracking-tight text-black underline"><span class=""><%= @recent_products.count %></span> Recent Products:</h2>
            <button class="bg-white text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow]">
            <%= link_to marketplace_browse_recent_path, class: "link" do %>
              Browse All Recent Repositories
              <span aria-hidden="true">&rarr;</span>
            <% end %>
            </button>
          </div>
        </section>
    <hr class="h-px bg-black border-8 border-black">

     <div class="mt-6 overflow-hidden">
          <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/product", collection: @recent_products %>
            </div>
        </div>

        
      <% end %>

      <hr class="h-px mt-8 bg-black border-8 border-black">
      <% if @popular_products.size > 0 %>
        <!-- Popular Section -->
        <section aria-labelledby="popular-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="popular-heading" class="text-3xl font-bold tracking-tight text-black underline"><span class=""><%= @popular_products.count %></span> Popular Products:</h2>
            <button class="bg-white hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full">
            <%= link_to marketplace_browse_popular_path, class: "link" do %>
              Browse All Popular Repositories
              <span aria-hidden="true">&rarr;</span>
            <% end %>
             </button>
          </div>
        </section>
        <hr class="h-px bg-black border-8 border-black">
        
          

         <div class="mt-6 overflow-hidden">
             <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/product", collection: @popular_products %>
            </div>
              </div>
      
      <% end %>
      <hr class="h-px mt-8 bg-black border-8 border-black">
    <%= render 'middleTwo' %>
    <hr class="h-px bg-black border-8 border-black">
      <% if @premium_products.size > 0 %>
        <!-- Premium Section -->
        <section aria-labelledby="popular-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="popular-heading" class="text-3xl font-bold tracking-tight text-black underline"><span class=""><%= @premium_products.count %></span> Premium Products:</h2>
            <button class="bg-white hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full">
            <%= link_to marketplace_browse_premium_path, class: "link" do %>
              Browse All Premium Repositories
              <span aria-hidden="true">&rarr;</span>
            <% end %>
             </button>
          </div>
       </section>
        <hr class="h-px bg-black border-8 border-black">

          

         <div class="mt-6 overflow-hidden">
              <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/product", collection: @premium_products %>
            </div>
              </div>

        
      <% end %>
    <hr class="h-px mt-8 bg-black border-8 border-black">
      <% if @free_products.size > 0 %>
        <!-- Free Section -->
        <section aria-labelledby="popular-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="popular-heading" class="text-3xl font-bold tracking-tight text-black underline"><span class=""><%= @free_products.count %></span> Free Products:</h2>
            <button class="bg-white hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full">
            <%= link_to marketplace_browse_free_path, class: "link" do %>
              Browse All Free Repositories
              <span aria-hidden="true">&rarr;</span>
            <% end %>
             </button>
          </div>
        <hr class="h-px bg-black border-8 border-black">
        </section>
          

         <div class="mt-6 overflow-hidden">
              <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/product", collection: @free_products %>
            </div>
              </div>

        
      <% end %>
    <hr class="h-px mt-8 bg-black border-8 border-black">
 <% if @creators.size > 0 %>
        <!-- Creators Section -->
        <section aria-labelledby="creators-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="creators-heading" class="text-3xl font-bold tracking-tight text-black underline"><span class=""><%= @creators.count %></span> Creators:</h2>
            <button class="bg-white hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full ">
            <%= link_to marketplace_creators_path, class: "link" do %>
              Browse All Creators
              <span aria-hidden="true">&rarr;</span>
            <% end %>
            </button>
          </div>
           </section>
          <hr class="h-px bg-black border-8 border-black">
          <div class="mt-6 overflow-hidden">
             <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/creator", collection: @creators %>
            </div>
              </div>
       
      <% end %>
    <hr class="h-px mt-8 bg-black border-8 border-black">
      <%= render 'middle' %>
    <hr class="h-px bg-black border-8 border-black">
      <% if @languages.size > 0 %>
        <!-- Languages Section -->
        <section aria-labelledby="languages-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="languages-heading" class="text-3xl font-bold tracking-tight text-black underline "><span class=""><%= @languages.count %></span> Programming Languages:</h2>
            <button class="bg-white hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full ">
            <%= link_to marketplace_browse_languages_path, class: "link" do %>
              Browse All Languages
              <span aria-hidden="true">&rarr;</span>
            <% end %>
            </button>
          </div>
          </section>
          <hr class="h-px bg-black border-8 border-black">
          <div class="mt-6 flow-root">
            <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/language", collection: @languages, as: :language %>
            </div>
          </div>
        
      <% end %>
      <hr class="h-px mt-8 bg-black border-8 border-black">
      <% if @categories.size > 0 %>
        <!-- Categories Section -->
        <section aria-labelledby="categories-heading" class="bg-orange-400">
          <div class="px-4 sm:flex sm:items-center sm:justify-between sm:px-6 lg:px-8 xl:px-0">
            <h2 id="categories-heading" class="text-3xl font-bold tracking-tight text-black underline "><span class=""><%= @categories.count %></span> Programming Categories:</h2>
            <button class="bg-white hover:shadow-[inset_22rem_0_0_0] hover:shadow-blue-400 duration-[400ms,700ms] transition-[color,box-shadow] text-black hover:text-white border-black border-4 font-bold py-2 px-4 rounded-full ">
            <%= link_to marketplace_browse_categories_path, class: "link" do %>
              Browse All Categories
              <span aria-hidden="true">&rarr;</span>
            <% end %>
            </button>
          </div>
          </section>
          <hr class="h-px bg-black border-8 border-black">
          <div class="mt-6 flow-root">
            <div class="grid grid-cols-2 mb-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-8 px-4 sm:px-6 lg:px-8 xl:px-0 ">
              <%= render partial: "home/category", collection: @categories, as: :category %>
            </div>
          </div>
      
      <% end %>
    <hr class="h-px mt-8 bg-black border-8 border-black">
    <%= render 'footer' %>
    <hr class="h-px bg-black border-8 border-black">
    </main>
  </div>
