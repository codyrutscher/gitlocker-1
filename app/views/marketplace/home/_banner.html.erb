<style>

#image {
  display: inline-block;
  height: 200px;
  width: 200px;
}


.stock-ticker {
  font-size: 15px;
  padding-block: 8px;
  overflow: hidden;
  user-select: none;
  border-block: 15px solid black;

  --gap: 20px;
  display: flex;
  gap: var(--gap);
}

.stock-ticker ul {
  list-style: none;
  flex-shrink: 0;
  min-width: 100%;
  display:flex;
  flex-wrap:wrap;
  flex-direction:row;
  justify-content: space-between;
  align-items: center;
  gap: var(--gap);

  <%# animation: scroll 20s linear infinite; %>
}


<%# @keyframes scroll {
  to {
    transform: translateX(calc(-100% - var(--gap)));
  }
} %>

</style>
