<html>
<head>
<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');
        
        :root {
            --primary-gradient: linear-gradient(135deg, #0ea5e9 0%, #8b5cf6 50%, #ec4899 100%);
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }
        
        .code-font {
            font-family: 'JetBrains Mono', monospace;
        }
        
        .bg-gradient {
            background: var(--primary-gradient);
        }
        
        .text-gradient {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .hero-pattern {
            background-color: #0F172A;
            background-image: 
                radial-gradient(circle at 25px 25px, rgba(255, 255, 255, 0.15) 2px, transparent 0),
                radial-gradient(circle at 75px 75px, rgba(255, 255, 255, 0.15) 2px, transparent 0);
            background-size: 100px 100px;
        }
        
        .glow-effect {
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.5), 0 0 30px rgba(14, 165, 233, 0.3);
        }
        
        .terminal {
            background-color: #1E293B;
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        
        .typing-animation {
            overflow: hidden;
            border-right: 2px solid #8B5CF6;
            white-space: nowrap;
            animation: typing 3.5s steps(40, end), blink-caret 0.75s step-end infinite;
            display: inline-block;
        }
        
        @keyframes typing {
            from { width: 0 }
            to { width: 100% }
        }
        
        @keyframes blink-caret {
            from, to { border-color: transparent }
            50% { border-color: #8B5CF6 }
        }
        
        .floating {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
        }
</style>
</head>
<div class="bg-indigo-100">
  <div class="mx-auto  py-10 sm:px-6 sm:py-10 lg:px-8">
    <div class="relative isolate overflow-hidden bg-gray-900 px-6 pt-16 shadow-2xl sm:rounded-3xl sm:px-10 md:pt-24 lg:flex lg:gap-x-20 lg:px-10 lg:pt-0">
      <svg viewBox="0 0 1024 1024" class="absolute left-1/2 top-1/2 -z-10 size-[64rem] -translate-y-1/2 [mask-image:radial-gradient(closest-side,white,transparent)] sm:left-full sm:-ml-80 lg:left-1/2 lg:ml-0 lg:-translate-x-1/2 lg:translate-y-0" aria-hidden="true">
        <circle cx="512" cy="512" r="512" fill="url(#759c1415-0410-454c-8f7c-9a820de03641)" fill-opacity="0.7" />
        <defs>
          <radialGradient id="759c1415-0410-454c-8f7c-9a820de03641">
            <stop stop-color="#7775D6" />
            <stop offset="1" stop-color="#E935C1" />
          </radialGradient>
        </defs>
      </svg>
      <div class="mx-auto max-w-md text-center lg:mx-0 lg:flex-auto lg:py-32 lg:text-left">
        <%= image_tag "https://www.coderz.us/assets/coderz-cfe1fce4096a63cc8d20e62db00b93087c7d02667f06be9af7fc117cbc7cab93.png", class: "h-12 w-40 mb-4", alt: "Coderz Logo" %>
        <h1 class="text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl">Your All-In-One <span class="underline font-bold italic">Version Control Marketplace</span> with <span class="bg-gradient-to-r from-rose-400 via-fuchsia-500 to-indigo-500 bg-[length:100%_6px] bg-no-repeat bg-bottom">AI commits!</span> Browse Projects From <%= User.count %> Developers Or Post Your Code To <span class="underline font-bold italic">Start Earning</span></h1>
        <p class="mt-6 text-pretty text-lg/8 text-gray-300"></p>
        <div class="mt-10 flex items-center justify-center gap-x-6 lg:justify-start">
          <a href="https://www.coderz.us/marketplace/browse/featured" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Featured</a>
          <a href="https://www.coderz.us/marketplace/creators" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Developers</a>
          <a href="https://www.coderz.us/marketplace/browse" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Browse</a>
          <a href="https://www.coderz.us/products/new" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Create</a>
        </div>
        <div class="pt-4 mt-4">
          <a href="https://www.coderz.us/funds" class="text-sm/6 font-semibold px-3.5 py-2.5 border-white border-2 text-white">Get Paid <span aria-hidden="true">→</span></a>
        </div>
         <div class="pt-4 mt-4 flex items-center lg:justify-start gap-x-6">
          <a href="https://www.coderz.us/marketplace/purchases" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">My Purchased Repositories</a>
          <a href="https://www.coderz.us/products" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">My Listed Repositories</a>
        </div>
      </div>





      <div class="relative mt-16 h-80 lg:mt-8">
        <img class="absolute left-0 top-0 w-[57rem] max-w-none rounded-md bg-white/5 ring-1 ring-white/10" src="https://tailwindui.com/plus-assets/img/component-images/dark-project-app-screenshot.png" alt="App screenshot" width="1824" height="1080">
      </div>
    </div>
  </div>
</div>

</html>
