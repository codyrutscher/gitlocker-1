<html>
<head>
<style>
  ul {
  padding-left: 20px;
}
ol {
  padding-left: 20px;
}
li {
  list-style-type: space-counter;
}
h1 {
  font-size: 40px;
  padding-top: 15px
  padding-bottom: 15px
  padding-left: 0px;
}
h2 {
  font-size: 30px;
  padding-top: 15px
  padding-bottom: 15px
  padding-left: 0px;
}
p li {
  font-size: 15px;
}
li {
padding-top: 10px;
padding-bottom: 10px; 
}

</style>

</head>

<%= content_for :meta_title, @blog.title %>
<%= content_for :meta_description, ActionView::Base.full_sanitizer.sanitize(@blog.content)&.first(160)&.humanize %>
<div id="backgroundImageFaq" class="bg-white">
  <div class="container bg-gray-200 mx-auto px-4 py-6">
    <h1 class="text-3xl text-black font-bold underline mb-4"><%= @blog.title %></h1>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <% if @blog.image.attached? %>
      <div class="mb-6">
        <%= image_tag url_for(@blog.image), class: "w-full h-auto rounded-lg border-4 shadow-2xl", alt: "#{@blog.title}" %>
      </div>
    <% end %>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <div class="text-black mb-6" id="blog-content">
      <%= @blog.content.html_safe %>
    </div>
    <hr class="h-px bg-black border-4 mt-4 mb-4 border-black">
    <div class="mt-6">
      <%= link_to 'Back to Blogs', blogs_path, class: "group relative inline-flex h-12 items-center justify-center overflow-hidden rounded-md border-2 border-black bg-transparent px-6 font-medium text-neutral-600 transition-all duration-100 [box-shadow:5px_5px_rgb(0_0_255)] hover:translate-x-[3px] hover:translate-y-[3px] hover:[box-shadow:0px_0px_rgb(0_0_255)]" %>
    </div>
  </div>
</div>
</html>
