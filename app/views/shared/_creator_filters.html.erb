<%= form_with url: marketplace_creators_path, method: :get, local: true, id: 'filter_form' do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= select_tag :creator_sort_by, options_for_select([
      ['Sort By Most Total Earnings', 'total_earnings'],
      ['Sort By Newest To Oldest Users', 'newest'],
      ['Sort By Oldest To Newest Users', 'oldest'],
      ['Sort By Most Followers', 'most_followers'],
      ['Sort Alphabetically By Name', 'name_asc'],
    ], params[:creator_sort_by]), prompt: 'Sort Creator By', class: 'form-select block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm' %>

    <%= submit_tag 'Apply Filters', class: 'btn btn-primary group relative inline-flex h-12 items-center justify-center overflow-hidden rounded-md border-2 border-black bg-transparent px-6 font-medium text-neutral-600 transition-all duration-100 [box-shadow:5px_5px_rgb(0_0_255)] hover:translate-x-[3px] hover:translate-y-[3px] hover:[box-shadow:0px_0px_rgb(0_0_255)]' %>
  </div>
<% end %>
