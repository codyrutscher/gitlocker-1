<%= form_with url: url_for(request.query_parameters.merge(sort_by: params[:sort_by])), method: :get, local: true, id: 'language_filter_form' do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 language-filter-grid">
    <%= select_tag :sort_by, options_for_select([
      ['Sort alphabetically a-z', 'alphabetical_asc'],
      ['Sort alphabetically z-a', 'alphabetical_desc'],
      ['Sort by oldest', 'oldest']
    ], params[:sort_by]), prompt: 'Sort By', class: 'language-sort-select form-select block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm' %>
    <%= submit_tag 'Apply Filters', class: 'language-filter-submit group relative inline-flex h-12 items-center justify-center overflow-hidden rounded-md border-2 border-black bg-transparent px-6 font-medium text-neutral-600 transition-all duration-100 [box-shadow:5px_5px_rgb(0_0_255)] hover:translate-x-[3px] hover:translate-y-[3px] hover:[box-shadow:0px_0px_rgb(0_0_255)]' %>
  </div>
<% end %>
