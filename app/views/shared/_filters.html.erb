        dataType: 'script',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'text/javascript'
        },
        success: function(response) {
          // DOM updates handled by the server
        }
      });
    });

    $("#price_filter").on('click', function () {
      const searchParams = new URLSearchParams(window.location.search);

      // Check if 'filters' exists in the search parameters
      let filters = searchParams.get('filters');
      
      // If 'filters' exists, parse it as JSON
      if (filters) {
        filters = JSON.parse(filters);
      } else {
        // If 'filters' doesn't exist, initialize it as an empty object
        filters = {};
      }

      // Get the min and max price values
      const minPrice = $('#min_price input').val();
      const maxPrice = $('#max_price input').val();

      if (minPrice === '' || maxPrice === '') {
        alert('Please enter both a minimum and maximum price');
        return;
      }
      // Add or update the 'price' filter
      filters.price = [minPrice, maxPrice];

      // Set or update the 'filters' parameter in the searchParams
      searchParams.set('filters', JSON.stringify(filters));

      // Remove the 'page' parameter if it exists
      searchParams.delete('page');

      // Update the URL with the modified search parameters
      const newUrl = `${window.location.pathname}?${searchParams.toString()}`;
      window.history.pushState({}, '', newUrl);

      // Perform AJAX request to update the content
      $.ajax({
        url: window.location.pathname,
        method: 'GET',
        data: searchParams.toString(),
        dataType: 'script',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'text/javascript'
        },
        success: function(response) {
          // DOM updates handled by the server
        }
      });
    });

  });
</script>
