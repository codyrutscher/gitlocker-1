            <label for="asc" class="ml-3 text-sm text-gray-600">A-Z</label>
          </div>
          <div class="flex items-center">
            <input id="alpha_z_a" type="radio" name="filters[alphabetical]" value="desc" 
                   <%= 'checked' if params.dig(:filters, :alphabetical) == 'desc' %> class="text-indigo-600">
            <label for="desc" class="ml-3 text-sm text-gray-600">Z-A</label>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>




