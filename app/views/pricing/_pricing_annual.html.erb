<div id="pricing_section" class="isolate mx-auto mt-10 grid max-w-md grid-cols-1 gap-8 md:max-w-2xl md:grid-cols-2 lg:max-w-4xl xl:mx-0 xl:max-w-none xl:grid-cols-4">
  <div class="rounded-3xl p-8 ring-1 ring-gray-200 hover:ring-indigo-600">
    <h2 id="tier-hobby" class="text-lg/8 font-semibold text-gray-900">Hobby</h2>
    <p class="mt-4 text-sm/6 text-gray-600">The essentials to provide your best work for clients.</p>
    <p class="mt-6 flex items-baseline gap-x-1">
      <!-- Price, update based on frequency toggle state -->
      <span class="text-4xl font-semibold tracking-tight text-gray-900">Free</span>
      <!-- Payment frequency, update based on frequency toggle state -->
    </p>
    <ul role="list" class="mt-8 space-y-3 text-sm/6 text-gray-600">
      <li class="flex gap-x-3">
        <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        Upload up to 10 products
      </li>
    </ul>
  </div>
  <div class="rounded-3xl p-8 ring-1 ring-gray-200 hover:ring-indigo-600">
    <h2 id="tier-freelancer" class="text-lg/8 font-semibold text-gray-900">Freelance</h2>
    <p class="mt-4 text-sm/6 text-gray-600">The essentials to provide your best work for clients.</p>
    <p class="mt-6 flex items-baseline gap-x-1">
      <!-- Price, update based on frequency toggle state -->
      <span class="text-4xl font-semibold tracking-tight text-gray-900">$100</span>
      <!-- Payment frequency, update based on frequency toggle state -->
      <span class="text-sm/6 font-semibold text-gray-600">/month</span>
    </p>
    <%= link_to 'Buy plan', pricing_subscription_path(stripe_price: ENV['FREELANCER_YEAR']), class: "mt-6 block rounded-md px-3 py-2 text-center text-sm/6 font-semibold text-indigo-500 hover:text-white shadow-sm bg-white hover:bg-indigo-500 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 #{ENV['FREELANCER_YEAR'] == @current_price_id ? 'disabled-link' : ''}" %>
    <% if ENV['FREELANCER_YEAR'] == @current_price_id %>
      <%= link_to 'Cancel Subscription', pricing_cancel_subscription_path, class: "mt-6 block rounded-md px-3 py-2 text-center text-sm/6 font-semibold text-indigo-500 hover:text-white shadow-sm bg-white hover:bg-indigo-500 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    <% end %>
    <ul role="list" class="mt-8 space-y-3 text-sm/6 text-gray-600">
      <li class="flex gap-x-3">
        <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        Upload up to 20 products
      </li>
    </ul>
  </div>
  <div class="rounded-3xl p-8 ring-2 ring-gray-200 hover:ring-indigo-600">
    <h2 id="tier-startup" class="text-lg/8 font-semibold text-gray-900">Startup</h2>
    <p class="mt-4 text-sm/6 text-gray-600">A plan that scales with your rapidly growing business.</p>
    <p class="mt-6 flex items-baseline gap-x-1">
      <!-- Price, update based on frequency toggle state -->
      <span class="text-4xl font-semibold tracking-tight text-gray-900">$150</span>
      <!-- Payment frequency, update based on frequency toggle state -->
      <span class="text-sm/6 font-semibold text-gray-600">/month</span>
    </p>
    <%= link_to 'Buy plan', pricing_subscription_path(stripe_price: ENV['STARTUP_YEAR']), class: "mt-6 block rounded-md px-3 py-2 text-center text-sm/6 font-semibold text-indigo-500 hover:text-white shadow-sm bg-white hover:bg-indigo-500 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 #{ENV['STARTUP_YEAR'] == @current_price_id ? 'disabled-link' : ''}" %>
    <% if ENV['STARTUP_YEAR'] == @current_price_id %>
      <%= link_to 'Cancel Subscription', 
                  pricing_cancel_subscription_path,
                  class: "mt-6 block rounded-md px-3 py-2 text-center text-sm/6 font-semibold text-indigo-500 hover:text-white shadow-sm bg-white hover:bg-indigo-500 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    <% end %>
    <ul role="list" class="mt-8 space-y-3 text-sm/6 text-gray-600">
      <li class="flex gap-x-3">
        <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        Upload up to 30 products
      </li>
    </ul>
  </div>
  <div class="rounded-3xl p-8 ring-1 ring-gray-200 hover:ring-indigo-600">
    <h2 id="tier-enterprise" class="text-lg/8 font-semibold text-indigo-600">Enterprise</h2>
    <p class="mt-4 text-sm/6 text-gray-600">Dedicated support and infrastructure for your company.</p>
    <p class="mt-6 flex items-baseline gap-x-1">
      <!-- Price, update based on frequency toggle state -->
      <span class="text-4xl font-semibold tracking-tight text-gray-900">$200</span>
      <!-- Payment frequency, update based on frequency toggle state -->
      <span class="text-sm/6 font-semibold text-gray-600">/month</span>
    </p>
    <%= link_to 'Buy plan', pricing_subscription_path(stripe_price: ENV['ENTERPRISE_YEAR']), class: "mt-6 block rounded-md px-3 py-2 text-center text-sm/6 font-semibold text-indigo-500 hover:text-white shadow-sm bg-white hover:bg-indigo-500 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 #{ENV['ENTERPRISE_YEAR'] == @current_price_id ? 'disabled-link' : ''}" %>
    <% if ENV['ENTERPRISE_YEAR'] == @current_price_id %>
      <%= link_to 'Cancel Subscription', pricing_cancel_subscription_path, class: "mt-6 block rounded-md px-3 py-2 text-center text-sm/6 font-semibold text-indigo-500 hover:text-white shadow-sm bg-white hover:bg-indigo-500 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
    <% end %>
    <ul role="list" class="mt-8 space-y-3 text-sm/6 text-gray-600">
      <li class="flex gap-x-3">
        <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        Upload Unlimited products
      </li>
    </ul>
  </div>
</div>