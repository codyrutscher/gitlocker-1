          "url": "https://www.gitlocker.com",
          "name": "<%= meta_title %>",
          "image": "<%= asset_url('logo.png') %>",
          "description": "<%= meta_description %>",
          "publisher": "GitLocker",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://www.gitlocker.com/search?search={search_term}",
            "query-input": "required name=search_term" }
          }
        }
      </script>
    <% end %>

