<%= content_for :meta_title, "GitLocker Sign Up" %>
<%= content_for :meta_description, "Join GitLocker today! Sign up to access exclusive repositories, connect with fellow developers, and unlock premium tools. Enhance your coding journey with GitLocker’s community-driven platform." %>

<div class="flex min-h-full pt-20 bg-gradient-to-l from-gray-200 via-fuchsia-200 to-stone-100>
  <div class="flex flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:flex-none lg:px-20 xl:px-24">
    <div class="mx-auto w-full max-w-sm lg:w-96">
      <div>
        <%= link_to marketplace_root_path do %>
          <%= image_tag "logo.png", class: "h-10 w-auto", alt: "Gitlocker Logo" %>
        <% end %>
        <h1 class="mt-8 text-2xl font-bold leading-9 tracking-tight text-gray-900">Sign up for an account</h1>
        <p class="mt-2 text-sm leading-6 text-gray-900">
          Already a member?
          <%= link_to "Log in here.", new_user_session_path, class: "font-semibold text-gray-900 hover:text-white" %>
        </p>
      </div>

      <div class="mt-10">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: {turbo: false}) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="space-y-6">
            <div>
              <%= f.label :email, class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= f.email_field :email, autocomplete: "email", class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6" %>
              </div>
            </div>

            <div>
              <%= f.label :password, class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= f.password_field :password, autocomplete: "new-password", class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6" %>
              </div>
              <% if @minimum_password_length %>
                <p class="mt-1 text-sm text-gray-500">Minimum <%= @minimum_password_length %> characters</p>
              <% end %>
            </div>

            <div>
              <%= f.label :password_confirmation, class: "block text-sm font-medium leading-6 text-gray-900" %>
              <div class="mt-2">
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 sm:text-sm sm:leading-6" %>
              </div>
            </div>

            <div>
              <%= f.submit "Sign up", class: "flex w-full justify-center rounded-md bg-blue-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
            </div>
          </div>
        <% end %>

        <div class="mt-6 relative">
          <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-gray-200"></div>
          </div>
          <div class="relative flex justify-center text-sm font-medium leading-6">
            <span class="bg-white px-6 text-gray-900">Or continue with</span>
          </div>
        </div>
      </div>

      <div class="mt-10">
        <div class="mt-10">
          <div class="relative">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-gray-200"></div>
            </div>
          </div>

          <div class="mt-6 grid grid-cols-1 gap-4">
            <%= button_to omniauth_authorize_path(User, :github),  method: :post, data: { turbo: "false" }, class: "flex w-full items-center justify-center gap-3 rounded-md bg-[#24292F] px-3 py-1.5 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#24292F]" do %>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-sm font-semibold leading-6">GitHub</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="relative hidden w-0 divide-y flex-1 lg:block">
    <img class="absolute inset-0 h-full w-full object-cover" src="https://gitlocker.s3.us-east-2.amazonaws.com/Programmer+working+on+PC.gif" alt="Programmer Working on PC Images">
  </div>
</div>
