<html>
<head>
<style>

</style>
</head>
<body>


<% if @template.name.length < 30 %>
  <% content_for :meta_title, "#{@template&.name&.titleize&.first(65)} | Coderz template " %>
<% else %>
  <% content_for :meta_title, @template&.name&.titleize&.first(65) %>
<% end %>






<div class="bg-indigo-100">
  <%=
    render BreadcrumbComponent.new(current_user,[
      { text: "Template", url: templates_path },
      { text: @template.name, url: request.original_url.include?("/l/") ? template_path(@template) : template_path(@template) }
    ])
  %>
<div class="mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <!-- Product -->
    <div class="flex flex-col md:flex-row md:items-center gap-4">
      <div class="grow">
        <h1 class="text-2xl font-bold tracking-tight text-black  underline sm:text-4xl"><%= @template.name %></h1>
	<p class="text-lg text-black">
          Last updated:
          <time datetime="<%= @template.updated_at.strftime("%Y-%m-%d") %>">
            <%= @template.updated_at.strftime("%B %-d, %Y") %>
          </time>
        </p>
      </div>
      <div class="flex flex-col gap-4 items-center">
        <%# Like %>
        <div id="like-section" class="flex items-center">
          <%= link_to new_product_path(template_id: @template.id), id: "like-button", class: "flex items-center gap-2 justify-center rounded border border-black border-2 bg-indigo-400 px-3 py-2 text-base font-medium text-black hover:text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-50" do %>
            <span id="total-likes">Clone this template</span>
          <% end %>
        </div>

        <% if @template.cloned_count == 1 %>
            <p class="text-2xl ">1 Clone</p>
        <% else %>
            <p class="text-2xl "><%= @template.cloned_count %> Clones</p>
        <% end %>

      </div>
    </div>

    <div class="my-8 w-full border-t-4 border-black"></div>

    <div class="lg:grid lg:grid-cols-7 lg:grid-rows-1 lg:gap-x-8 lg:gap-y-10 xl:gap-x-12">
      <!-- Product image -->
      <div class="lg:col-span-4 lg:row-end-1 flex flex-col gap-8 lg:gap-10 xl:gap-12">
        <div class="overflow-hidden rounded-lg bg-gray-100 bg">
          
        </div>
        <div class="bg rounded-lg ">
          <div class="rounded-lg flex flex-col">
            <div class="grow gap-3 grid md:grid-cols-5 sm:grid-cols-4 grid-cols-3">
              <%# Cover Image %>
                
            </div>
          </div>
        </div>
      </div>

      <!-- Product details -->
      <div class="flex flex-col gap-10 mx-auto mt-6 max-w-2xl sm:mt-6 lg:col-span-3 lg:row-span-2 lg:row-end-2 lg:mt-0 lg:max-w-screen-lg">
        <div id="description" class="flex rounded-2xl p-4 flex-col gap-6">
          <%# Price %>
          <div>
          </div>
	 <div> 
	</div>
         

          
        </div>


        <% if @template.description.present? %>
          <% if @template.description.length < 70 %>
            <%= content_for :meta_description, "#{ActionView::Base.full_sanitizer.sanitize(@template.description)&.humanize} product listed on the Coderz's code marketplace"  %>
          <% else %>
            <%= content_for :meta_description, ActionView::Base.full_sanitizer.sanitize(@template.description)&.humanize&.first(160) %>
          <% end %>
          <div id="description" class="flex border-black border-2 flex-col text-gray-900 h-fit p-4 rounded-2xl gap-4">
            <h2 class="text-2xl text-bold underline text-gray-900">Description:</h2>
            <p class="text-sm text-black"><%= sanitize @template.description %></p>
          </div>
          <div class="w-full border-t-4 border-black"></div>
        <% end %>

        

        

        <div id="description" class="flex rounded-2xl border-black border-2 flex-col p-4 gap-4">
          <h3 class="text-2xl font-medium underline text-black">License:</h3>
          <p class="text-sm text-black">For personal and professional use. You cannot resell or redistribute these repositories in their original state.</p>
        </div>

        <div class="w-full border-t-4 border-black"></div>

        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-medium text-gray-900">Share</h3>
          <ul role="list" class="flex items-center space-x-6">
            <li>
              <a href="<%= "https://www.facebook.com/sharer/sharer.php?u=#{template_url(@template)}" %>" target="_blank" rel="noopener noreferrer" class="flex h-6 w-6 items-center justify-center text-black hover:text-gray-500">
                <span class="sr-only">Share on Facebook</span>
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M20 10c0-5.523-4.477-10-10-10S0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.988C16.343 19.128 20 14.991 20 10z" clip-rule="evenodd" />
                </svg>
              </a>
            </li>
            <li>
              <a href="<%= "https://twitter.com/intent/tweet?url=#{template_url(@template)}" %>" target="_blank" rel="noopener noreferrer" class="flex h-6 w-6 items-center justify-center text-black hover:text-gray-500">
                <span class="sr-only">Share on Twitter</span>
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M11.4678 8.77491L17.2961 2H15.915L10.8543 7.88256L6.81232 2H2.15039L8.26263 10.8955L2.15039 18H3.53159L8.87581 11.7878L13.1444 18H17.8063L11.4675 8.77491H11.4678ZM9.57608 10.9738L8.95678 10.0881L4.02925 3.03974H6.15068L10.1273 8.72795L10.7466 9.61374L15.9156 17.0075H13.7942L9.57608 10.9742V10.9738Z" />
                </svg>
              </a>
            </li>
          </ul>
        </div>
      </div>

      

      <div class="mx-auto mt-16 w-full max-w-2xl lg:col-span-4 lg:mt-0 lg:max-w-none">
        <h2 class="text-2xl text-bold text-gray-900  mb-4 underline">Files In This Template:</h2>
        <% if @directory_tree_json != "[]"  %>
          <div id="directory-tree-data" class="js-directory-tree bg mb-4 bg-gray-400"></div>
        <% end %>
      </div>
    </div>
    

  </div>
</div>
<script type="text/javascript">
  $(document).ready(function() {
    
  });
</script>
<script type="load">
  $('#directory-tree-data').jstree({
		'core' : {
			'data' : <%= @directory_tree_json %>
		}
	});

  $('#directory-tree-data').on('select_node.jstree', function(e, data) {
    var node = data.node;
    if (node && node.original && node.original.type === 'file') {
        var fileName = node.text;
        var url = '<%= show_file_content_product_path(@template) %>';

        var form = document.createElement('form');
        form.method = 'GET';
        form.action = url;
        form.target = '_blank'; // Open in a new tab

        <%
=begin%>
 var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        var csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = 'authenticity_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput); 
<%
=end%>

        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'file_name';
        input.value = fileName;
        form.appendChild(input);

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }
  });
</script>

</body>
</html>
