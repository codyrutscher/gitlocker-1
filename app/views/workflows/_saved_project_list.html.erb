<p class="text-black font-bold leading-relaxed">
  Saved Projects
</p>
<div class="mt-1">
  <div class="flex items-center justify-center">
    <table class="table-auto m-8 p-8">
      <tbody>
        <% paginated_saved_projects&.each do |saved_project| %>
          <tr class="text-base">
            <td><%= link_to saved_project, project_from_s3_path(current_user, folder_name: saved_project), class: "py-2.5 px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 text-black font-medium", id: "open-folder-link" , local: false %></td>
            <td><%= button_to 'Delete', delete_project_path(current_user, folder_name: saved_project), method: :delete, form: { local: false, data: { turbo: false } } , class: 'focus:outline-none text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 ml-4 me-2 mb-2 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-900 bg-red-600', local: false %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<div class="mt-2 flex flex-col items-center justify-center">
  <%= render 'workflows/pagination', paginator: paginated_saved_projects, page_name: 'project_page', data: data %>
</div>