<h1 class="text-black font-bold leading-relaxed">Repositories:</h1>
<div class="mt-1">
  <div class="flex items-center justify-center">
    <table class="table-auto m-8 p-8">
      <thead>
        <tr>
          <th class="px-6 py-1">Repository Name</th>
          <th class="px-3 py-1">Type:</th>
          <th class="px-3 py-1">Branch:</th>
        </tr>
      </thead>
      <tbody>
        <% paginated_repositories&.each do |repo| %>
          <tr>
            <td class="px-6 py-1"><%= link_to repo[:name], download_repo_path(current_user, repo_name: repo[:name], branch_name: repo[:branch], username: @username), class: "text-black font-medium", id: "open-repo-link" , local: false %></td>
            <td><div class="px-3 py-1 border-2 bg-orange-500 hover:bg-orange-400 text-black hover:text-white border-black-500 rounded-lg"><%= repo[:type] %></div></td>
            <td><div class="px-3 py-1 border-2 bg-orange-500 hover:bg-orange-400 text-black hover:text-white border-black-500 rounded-lg"><%= repo[:branch] %></div></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<div class="mt-2 flex flex-col items-center justify-center">
  <%= render 'workflows/pagination', paginator: paginated_repositories, page_name: 'github_page' %>
</div>
