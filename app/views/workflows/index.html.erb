<div style="display: flex; flex: 1 width: 100%; height: 700px; max-height: 700px; border:1px solid silver;" class="flex">
  <div style="width: 35%; overflow:auto; background-color: #272822; color: #f8f8f2;">
    <div id="file-tree"></div>
  </div>
  <div style="width: 65%; background-color: #272822; color: #f8f8f2;">
    <div id="editor" style="height: 100%; width: 100%;">
    </div>
  </div>
</div>

<%= javascript_tag do %>
  var open_project = "<%= @open_project %>";
  var editor = ace.edit("editor");
  var fontSize = '18px';
  var setTheme = 'ace/theme/monokai';
  var tabSize = '2';
  editor.setTheme("ace/theme/monokai");
  editor.session.setTabSize(2);
  editor.setOptions({
    fontSize: "18px"
  });
  editor.session.setMode("ace/mode/text");
  editor.setValue("", -1);

  function changeTabSize() {
    editor.getSession().setTabSize($('#tab-size').val());
    tabSize = `$('#tab-size').val()`;
  }

  function changeFontSize() {
    fontSize = `${$('#font-size-selector').val()}`;
    editor.setOptions({
      fontSize: $('#font-size-selector').val()
    });
  }

  function changeTheme() {
    editor.setTheme(`ace/theme/${$('#theme-selector').val()}`);
    setTheme = `ace/theme/${$('#theme-selector').val()}`;
  }

  function updatemenu() {
    if (document.getElementById('responsive-menu').checked == true) {
      document.getElementById('menu').style.borderBottomRightRadius = '0';
      document.getElementById('menu').style.borderBottomLeftRadius = '0';
    }else{
      document.getElementById('menu').style.borderRadius = '10px';
    }
  }

  $(document).ready(function() {
    const projectNameInput = $("#project-name");
    const successMessage = $("#success-message");
    const errorMessage = $("#error-message");
    const createNewProjBtn = $("#create-new-project-btn");

    function validateFolderName(folderName) {
      const folderNamePattern = /^[A-Za-z0-9-_]{3,20}$/;
      return folderNamePattern.test(folderName);
    }

    projectNameInput.on("input", function() {
      const folderName = projectNameInput.val();
      if (validateFolderName(folderName)) {
        successMessage.removeClass("hidden");
        errorMessage.addClass("hidden");
        createNewProjBtn.prop("disabled", false);
      } else {
        errorMessage.removeClass("hidden");
        successMessage.addClass("hidden");
        createNewProjBtn.prop("disabled", true);
      }
    });

    const fileEdit = "<%= open_file_path(current_user) %>";
    const createFilePath = "<%= create_file_path(current_user) %>";
    const renameFilePath = "<%= rename_file_path(current_user) %>";
    const renameFolderPath = "<%= rename_folder_path(current_user) %>";
    const deleteFilePath = "<%= delete_file_path(current_user) %>";
    const deleteProjectPath = "<%= delete_project_path(current_user) %>";
    var data = <%= @directory_tree_json %>;
    const extensionToMode = {
      '.js': 'ace/mode/javascript',
      '.ts': 'ace/mode/typescript',
      '.py': 'ace/mode/python',
      '.php': 'ace/mode/php',
      '.rb': 'ace/mode/ruby',
      '.java': 'ace/mode/java',
      '.cpp': 'ace/mode/c_cpp',
      '.go': 'ace/mode/golang',
      '.rs': 'ace/mode/rust',
      '.swift': 'ace/mode/swift',
      '.kt': 'ace/mode/kotlin',
      '.scala': 'ace/mode/scala',
      '.hs': 'ace/mode/haskell',
      '.fs': 'ace/mode/fsharp',
      '.lua': 'ace/mode/lua',
      '.pl': 'ace/mode/perl',
      '.h': 'ace/mode/objectivec',
      '.cs': 'ace/mode/csharp',
      '.vb': 'ace/mode/vbnet',
      '.html': 'ace/mode/html',
      '.xml': 'ace/mode/xml',
      '.css': 'ace/mode/css',
      '.less': 'ace/mode/less',
      '.sass': 'ace/mode/sass',
      '.scss': 'ace/mode/scss',
      '.styl': 'ace/mode/stylus',
      '.haml': 'ace/mode/haml',
      '.pug': 'ace/mode/pug',
      '.ejs': 'ace/mode/ejs',
      '.coffee': 'ace/mode/coffeescript',
      '.ls': 'ace/mode/livescript',
      '.dart': 'ace/mode/dart',
      '.hx': 'ace/mode/haxe',
      '.jl': 'ace/mode/julia',
      '.erl': 'ace/mode/erlang',
      '.ml': 'ace/mode/ocaml',
      '.vala': 'ace/mode/vala',
      '.d': 'ace/mode/d',
      '.json': 'ace/mode/json',
      '.yaml': 'ace/mode/yaml',
      '.sql': 'ace/mode/sql',
      '.md': 'ace/mode/markdown',
      '.tex': 'ace/mode/latex',
      '.glsl': 'ace/mode/glsl',
      '.hbs': 'ace/mode/handlebars',
      '.mustache': 'ace/mode/mustache',
      '.djhtml': 'ace/mode/django',
      '.smarty': 'ace/mode/smarty',
      '.txt': 'ace/mode/text',
      '.diff': 'ace/mode/diff',
      '.adoc': 'ace/mode/asciidoc',
      '.ini': 'ace/mode/ini',
      '.conf': 'ace/mode/apache_conf',
      '.logiql': 'ace/mode/logiql',
      '.rdoc': 'ace/mode/rdoc',
      '.snippet': 'ace/mode/snippet',
      '.feature': 'ace/mode/gherkin',
      '.frontmatter': 'ace/mode/yaml-front-matter',
    };

    function buildLinks(node, path = '') {
      const currentPath = path ? `${path}/${node.text}` : node.text;
      node.a_attr = {
        href: fileEdit + `?file_path=${currentPath}`,
        class: 'js-tree-node'
      };

      if (node.children && node.children.length > 0) {
        node.children.forEach(child => buildLinks(child, currentPath));
      } else {
        node.a_attr = {
          href: fileEdit + `?file_path=${currentPath}`,
          class: 'js-tree-node'
        };
      }
    }
    if (Object.keys(data).length !== 0) {
      data.forEach(folder => buildLinks(folder));
    }
    $('#file-tree').jstree({
      'core' : {
        'check_callback' : true,
        'data' : data
      },
      'plugins' : ['state','dnd','types','contextmenu','unique'],
      "types": {
          "root_folder": { "icon": "jstree-folder" },
          "default": { "icon": "jstree-folder" },
          "folder": { "icon": "jstree-folder" },
          "file": { "icon": "jstree-file" }
      },
      "contextmenu": {
        items: function($node) {
          var items = {};
          if ($node.type === "folder" || $node.type === "root_folder") {
            items["create_folder"] = {
              "label": "Create Folder",
              "action": function () {
                var newFolderName = "NewFolder";
                newFolderName = getUniqueName($node, newFolderName);
                var newFolder = {
                  "text": `${newFolderName}`,
                  "icon": "jstree-folder",
                  "type": "folder",
                  "children": [],
                  a_attr: { href: `${$node.a_attr.href}/${newFolderName}`, class: 'js-tree-node' }
                };
                $("#file-tree").jstree(true).create_node($node, newFolder, "last", function (new_node) {
                  if (new_node) {
                    createFile(new_node);
                    $("#file-tree").jstree(true).open_node($node);
                    $("#file-tree").jstree(true).edit(new_node);
                  }
                });
              }
            };

            items["create_file"] = {
              "label": "Create File",
              "action": function () {
                var newFileName = "NewFile";
                newFileName = getUniqueName($node, newFileName);
                var newFile = {
                  "text": `${newFileName}`,
                  "icon": "jstree-file",
                  "type": "file",
                  a_attr: { href: `${$node.a_attr.href}/${newFileName}`, class: 'js-tree-node' }
                };
                $("#file-tree").jstree(true).create_node($node, newFile, "last", function (new_node) {
                  if (new_node) {
                    createFile(new_node);
                    $("#file-tree").jstree(true).open_node($node);
                    $("#file-tree").jstree(true).edit(new_node);
                  }
                });
              }
            };
          }
          if ($node.type === "folder" || $node.type === "file") {
            items["rename"] = {
              "label": "Rename",
              "action": function () {
                $("#file-tree").jstree(true).edit($node);
              }
            };
            items["remove"] = {
              "label": "Delete",
              "action": function () {
                $("#file-tree").jstree(true).delete_node($node);
              }
            };
          }
          return items;
        }
      }
    });

    function getUniqueName(parentNode, baseName) {
      var counter = 1;
      var uniqueName = baseName;
      var children = $("#file-tree").jstree(true).get_node(parentNode.id).children;
      var existingNames = children.map(function(childId) {
        return $("#file-tree").jstree(true).get_node(childId).text;
      });
      while (existingNames.includes(uniqueName)) {
        uniqueName = baseName + "_" + counter;
        counter++;
      }
      return uniqueName;
    }

    $("#file-tree").on("rename_node.jstree", function (e, data) {
      oldFileName = data.old;
      newFileName = data.text;
      oldNode = data.node;
      oldFilePath = data.node.a_attr.href.split('?')[1].replace('file_path=','');
      fileType = data.node.type;
      if (fileType === 'file') {
        $.ajax({
          url: renameFilePath,
          method: 'GET',
          data: {
            old_file_name: oldFileName,
            new_file_name: newFileName,
            old_file_path: oldFilePath,
            type: fileType
          },
          dataType: 'json',
          success: function(data) {
            if (data.file_href !== null && data.file_href !== undefined) {
              newHref = decodeURIComponent(data.file_href);
              $(`#${oldNode.id}_anchor`).attr("href",newHref);
            }
          },
          error: function(jqXHR, textStatus, errorThrown) {
            if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
              errorMessage = jqXHR.responseJSON.error;
              alert(errorMessage);
            }
          }
        });
      }
      else {
        $.ajax({
          url: renameFolderPath,
          method: 'GET',
          data: {
            old_file_name: oldFileName,
            new_file_name: newFileName,
            old_file_path: oldFilePath,
            type: fileType
          },
          dataType: 'json',
          success: function(data) {
            if (data.directory_tree_json !== null && data.directory_tree_json !== undefined) {
              updated_directory_tree_json = JSON.parse(data.directory_tree_json);
              if (Object.keys(updated_directory_tree_json).length !== 0) {
                updated_directory_tree_json.forEach(folder => buildLinks(folder));
              }
              refreshTree(updated_directory_tree_json);
            }
          },
          error: function(jqXHR, textStatus, errorThrown) {
            if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
              responseJSON = jqXHR.responseJSON;
              if (responseJSON.directory_tree_json !== null && responseJSON.directory_tree_json !== undefined) {
                updated_directory_tree_json = JSON.parse(responseJSON.directory_tree_json);
                if (Object.keys(updated_directory_tree_json).length !== 0) {
                  updated_directory_tree_json.forEach(folder => buildLinks(folder));
                }
                refreshTree(updated_directory_tree_json);
              }
              alert(jqXHR.responseJSON.error);
            }
          }
        });
      }
    });

    $('#file-tree').on('delete_node.jstree', function (e, data) {
      removedFilePath = data.node.a_attr.href.split('?')[1].replace('file_path=','');
      $.ajax({
        url: deleteFilePath,
        method: 'GET',
        data: {
          removed_file_path: removedFilePath
        },
        dataType: 'json',
        success: function(data) {
        },
        error: function(jqXHR, textStatus, errorThrown) {
          if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
            responseJSON = jqXHR.responseJSON;
            if (responseJSON.directory_tree_json !== null && responseJSON.directory_tree_json !== undefined) {
              updated_directory_tree_json = JSON.parse(responseJSON.directory_tree_json);
              if (Object.keys(updated_directory_tree_json).length !== 0) {
                updated_directory_tree_json.forEach(folder => buildLinks(folder));
              }
              refreshTree(updated_directory_tree_json);
            }
            alert(jqXHR.responseJSON.error);
          }
        }
      });
    });

    function createFile(new_node) {
      file_path = new_node.a_attr.href.split('?')[1].replace('file_path=','')
      $.ajax({
        url: createFilePath,
        method: 'GET',
        data: {
          file_path: file_path,
          type: new_node.type
        },
        dataType: 'json',
        success: function(data) {
        },
        error: function(jqXHR, textStatus, errorThrown) {
          if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
            alert(jqXHR.responseJSON.error);
          }
        }
      });
    }

    function refreshTree(newData) {
      var tree = $('#file-tree').jstree(true);
      tree.settings.core.data = newData;
      tree.refresh(false, false);
    }

    $.ajaxSetup({
      headers: {
        'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
      }
    });

    $(document).off('click', '.js-tree-node').on('click', '.js-tree-node', function (event) {
      event.preventDefault();
      var href = $(this).attr('href');
      var file_path = href.split('?')[1].replace('file_path=','');
      var folder_name = "<%= @folder_name %>";
      $.ajax({
        url: href,
        method: 'GET',
        dataType: 'json',
        success: function(data) {
          if (data.file_data !== null) {
            var file_ext = data.file_ext;
            if (file_ext in extensionToMode) {
              editor.session.setMode(extensionToMode[file_ext]);
            } else {
              editor.session.setMode('ace/mode/text');
            }
            editor.setValue(data.file_data, -1);
            $("#save_file").attr("href", "<%= save_file_path(current_user) %>?file_path=" + encodeURIComponent(file_path));
            $("#push-to-git").attr("href", "<%= push_to_git_path(current_user) %>?folder_name=" + encodeURIComponent(folder_name) + "&file_path=" + encodeURIComponent(file_path));
            $("#file_name").text(file_path.replace('file_path=','').split('/').slice(-1)[0]);
            $("#file-breadcrumb").text(file_path.replace('file_path=',''));
          }
        },
        error: function(jqXHR, textStatus, errorThrown) {
          if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
            errorMessage = jqXHR.responseJSON.error;
            alert(errorMessage);
          }
        }
      });
    });
  
    $(document).off('click', '#save_file').on('click', '#save_file', function (event) {
      event.preventDefault();
      var href = $(this).attr('href');
      if (href === 'javascript:void(0);') {
        return
      }
      var file_path = href.split('?')[1];
      updated_file_data = editor.getValue();
      $.ajax({
        url: href,
        method: 'POST',
        dataType: 'json',
        data: { updated_file_data: updated_file_data },
        success: function(data) {
          editor.setValue("", -1);
          $("#save_file").attr("href", "javascript:void(0);");
          $("#push-to-git").attr("href", "javascript:void(0);");
          $("#file_name").text("");
          $("#file-breadcrumb").text("");
        },
        error: function(jqXHR, textStatus, errorThrown) {
          if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
            errorMessage = jqXHR.responseJSON.error;
            alert(errorMessage);
          }
        }
      });
    });

    $(document).on('click', '#download-zip', function (event) {
      var href = $(this).attr('href');
      if (href && !href.includes('folder_name')) {
        event.preventDefault();
      }
    });


    $(document).on('click', '#open-workflow-modal, #open-upload-zip-modal, #open-github-modal, #open-new-project-modal, #open-editor-setting-modal', function (event) {
      if (open_project === '') {
        var button_id = this.id;
        var modal_id = button_id.replace('open-','');
        $(`#${modal_id}`).removeClass('hidden');
        $(`#${modal_id}`).addClass('flex');
      } else {
        $('#existing-project-modal').removeClass('hidden');
        $('#existing-project-modal').addClass('flex');
      }
    });

    $(document).on('click', '#close-workflow-modal-svg, #close-workflow-modal-btn, #close-upload-zip-modal-svg, #close-upload-zip-modal-btn, #close-github-modal-svg, #close-github-modal-btn, #close-new-project-modal-btn, #close-new-project-modal-svg, #close-editor-setting-modal-svg, #close-editor-setting-modal-btn, #close-existing-project-modal-svg, #close-existing-project-modal-btn', function (event) {
      var button_id = this.id;
      var modal_id = button_id.replace('close-','').replace('-svg','').replace('-btn','');
      $(`#${modal_id}`).addClass('hidden');
    });

    $(document).on('click', '#open-folder-link', function (event) {
      editor.destroy();
      editor.container.remove();
    });
    refreshTree(data);
  });
<% end %>