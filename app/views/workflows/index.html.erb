<nav id='menu'>
  <input type='checkbox' id='responsive-menu' onclick='updatemenu()'><label></label>
  <ul>
    <li><a href='javascript:void(0);' id="open-new-project-modal">New Project</a></li>
    <li><a class='dropdown-arrow' href='javascript:void(0);'>Import Project</a>
      <ul class='sub-menus'>
        <li><a href='javascript:void(0);' id="open-github-modal">From GitHub</a></li>
        <li><a href="javascript:void(0);" id="open-upload-zip-modal">From Local</a></li>
        <li><a href="javascript:void(0);" id="open-workflow-modal">Saved Projects</a></li>
      </ul>
    </li>
    <li><a class='dropdown-arrow' href='javascript:void(0);'>Export Project</a>
      <ul class='sub-menus'>
        <li><%= link_to 'Download ZIP', download_zip_path(current_user, folder_name: @folder_name), id: 'download-zip' %></li>
        <li><a href='javascript:void(0);' id="push-to-git">Push To GitHub</a></li>
        <% save_project_url = save_project_url(current_user, folder_name: @folder_name) %>
        <li><a href="<%= save_project_url %>" id="save-project">Save Project</a></li>
      </ul>
    </li>
    <li><a href='javascript:void(0);' id="open-editor-setting-modal">Editor Settings</a></li>
    <li><a href='javascript:void(0);' id="save_file">Save File</a></li>
    <li>
      <a href="javascript:void(0);" class="block ps-auto px-2 text-black" id="file_name" disabled></a>
    </li>
    <li>
      <p class="block font-small text-white" id="file-breadcrumb"></p>
    </li>
  </ul>
</nav>

<div id="existing-project-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-2xl max-h-full">
    <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
          Please Save existing open projects.
        </h3>
        <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" id="close-existing-project-modal-svg">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close</span>
        </button>
      </div>
      <div class="p-4 md:p-5 space-y-4">
        <p class="text-black leading-relaxed">
          Please select what you want to do with the projects that are already <span class="font-bold">opened and not saved</span> before moving further.
        </p>
        <% @open_projects&.each do |folder| %>
          <div class="flex text-base leading-relaxed">
            <p class="py-2.5 px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white text-black font-medium"><%= folder %></p>
            <%= link_to 'Open Project', workflows_path(current_user, folder_name: folder), class: "py-2.5 px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 text-black font-medium", local: false %>
            <%= link_to 'Save Changes', save_project_url(current_user, folder_name: folder), class: "py-2.5 px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 text-black font-medium", local: false %>
            <%= button_to 'Remove Changes', remove_existing_project_path(current_user, folder_name: folder), method: :delete, local: false, form: { local: false, data: { turbo: false } }, class: 'focus:outline-none text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 ml-4 me-2 mb-2 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-900 bg-red-600' %>
          </div>
        <% end %>
      </div>
      <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
        <button id="close-existing-project-modal-btn" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Close</button>
      </div>
    </div>
  </div>
</div>

