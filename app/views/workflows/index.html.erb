<nav id='menu'>
  <input type='checkbox' id='responsive-menu' onclick='updatemenu()'><label></label>
  <ul>
    <li><a href='javascript:void(0);' disabled>New Project</a></li>
    <li><a class='dropdown-arrow' href='javascript:void(0);' disabled>File</a>
      <ul class='sub-menus'>
        <li><a href='javascript:void(0);' disabled>New File</a></li>
        <li><a href='javascript:void(0);' disabled>New Folder</a></li>
      </ul>
    </li>
    <li><a class='dropdown-arrow' href='javascript:void(0);'>Import Project</a>
      <ul class='sub-menus'>
        <li><a href='javascript:void(0);' id="open-github-modal">From GitHub</a></li>
        <li><a href="javascript:void(0);" id="open-upload-zip-modal">From Local</a></li>
        <li><a href="javascript:void(0);" id="open-workflow-modal">Saved Projects</a></li>
      </ul>
    </li>
    <li><a class='dropdown-arrow' href='javascript:void(0);'>Export Project</a>
      <ul class='sub-menus'>
        <li><a href='javascript:void(0);' disabled>Save Project</a></li>
        <li><a href="<%= download_zip_path(current_user, folder_name: @folder_name) %>" id="download-zip">Download Zip</a></li>
        <li><a href='javascript:void(0);' id="push-to-git">Push To GitHub</a></li>
      </ul>
    </li>
    <li><a href='javascript:void(0);' disabled>Editor Settings</a></li>
    <li><a href='javascript:void(0);' id="save_file">Save File</a></li>
    <li>
      <a href="javascript:void(0);" class="block ps-auto px-2 text-black" id="file_name" disabled></a>
    </li>
    <li>
      <p class="block font-small text-white" id="file-breadcrumb"></p>
    </li>
  </ul>
</nav>

<div id="github-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-2xl max-h-full">
    <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
          Select Project From Github
        </h3>
        <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" id="close-github-modal-svg">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close</span>
        </button>
      </div>
      <div class="p-4 md:p-5 space-y-4">
        <% if @repos.size == 0 %>
          <p class="text-base leading-relaxed text-gray-500 dark:text-gray-400">
            Currently you do not have any repositories in Github.
          </p>
        <% else %>
          <p class="text-black font-bold leading-relaxed">
            Repositories
          </p>
          <% @repos.each do |repo| %>
            <p class="text-base leading-relaxed">
              <%= link_to repo, download_repo_path(current_user, repo_name: repo, username: @username), class: "text-black font-medium", id: "open-repo-link" , local: false %>            
            </p>
          <% end %>
        <% end %>
      </div>
      <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
        <button id="close-github-modal-btn" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Close</button>
      </div>
    </div>
  </div>
</div>

<div id="workflow-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-2xl max-h-full">
    <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
          Open Workflow
        </h3>
        <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" id="close-workflow-modal-svg">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close</span>
        </button>
      </div>
      <div class="p-4 md:p-5 space-y-4">
        <% if @folders.size == 0 %>
          <p class="text-base leading-relaxed text-gray-500 dark:text-gray-400">
            Currently you do not have any workflows saved.
          </p>
        <% else %>
          <p class="text-black font-bold leading-relaxed">
            Saved Workflows
          </p>
          <% @folders.each do |folder| %>
            <p class="text-base leading-relaxed">
              <%= link_to folder, workflows_path(current_user, folder_name: folder), class: "text-black font-medium", id: "open-folder-link" , local: false %>
            </p>
          <% end %>
        <% end %>
      </div>
      <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
        <button id="close-workflow-modal-btn" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Close</button>
      </div>
    </div>
  </div>
</div>

<div id="upload-zip-modal" data-modal-backdrop="static" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
  <div class="relative p-4 w-full max-w-2xl max-h-full">
    <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
      <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
              Upload ZIP
          </h3>
          <button type="button" id="close-upload-zip-modal-svg" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white">
              <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
              </svg>
              <span class="sr-only">Close</span>
          </button>
      </div>
      <div class="p-4 md:p-5 space-y-4">
        <%= form_with url: upload_zip_path(current_user), method: :post, local: false do |f| %>
          <%= f.file_field :upload_file, class: "py-2.5 ms-3 form-control w-full", accept: ".zip", required: true %>
          <%= f.submit "Upload ZIP", class: "py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700" %>
        <% end %>
      </div>
      <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
        <button id="close-upload-zip-modal-btn" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="flex justify-between container mx-auto">
  <div class="inline-flex">
    <ul class="flex flex-row font-medium bg-white">
      <li>
        <a href="javascript:void(0);" class="block py-2 px-3 text-black" id="open-workflow-modal">Open  Workflow</a>
      </li>
      <li>
        <a href="javascript:void(0);" class="block py-2 px-3 text-black" id="open-upload-zip-modal">Upload ZIP</a>
      </li>
    </ul>
  </div>
  <div class="inline-flex">
    <ul class="flex flex-row font-medium bg-white text-center">
      <li>
        <a href="javascript:void(0);" class="block px-1 text-black" id="file_name" disabled></a>
        <div class="git-file-name">
          <a href="javascript:void(0);" class="block font-small text-black" id="breadcrumb" disabled>
          </a>
        </div>
      </li>
    </ul>
  </div>
  <div class="inline-flex">
    <ul class="flex flex-row font-medium bg-white">
      <li>
        <a href="javascript:void(0);" class="block py-2 px-3 text-black" id="save_file">Save File</a>
      </li>
      <li>
        <a href="<%= download_zip_path(current_user, folder_name: @folder_name) %>" class="block py-2 px-3 text-black">Download ZIP</a>
      </li>
    </ul>
  </div>
</div>


<div style="display: flex; flex: 1 width: 100%; height: 700px; max-height: 700px; border:1px solid silver;" class="flex">
  <div class="bg-black" style="width: 35%; overflow:auto;">
    <div id="file-tree" class="text-white"></div>
  </div>
  <div style="width: 65%;">
    <div id="editor" style="height: 100%; width: 100%;">
    </div>
  </div>
</div>

<script>
  $(document).ready(function() {
    var editor = ace.edit("editor");
    editor.setTheme("ace/theme/monokai");
    editor.session.setTabSize(2);
    editor.setFontSize("18px");
    editor.session.setMode("ace/mode/text");
    editor.setValue("", -1);
    const fileEdit = "<%= open_file_path(current_user) %>";
    var data = <%= @directory_tree_json %>;
    const extensionToMode = {
      '.js': 'ace/mode/javascript',
      '.ts': 'ace/mode/typescript',
      '.py': 'ace/mode/python',
      '.php': 'ace/mode/php',
      '.rb': 'ace/mode/ruby',
      '.java': 'ace/mode/java',
      '.cpp': 'ace/mode/c_cpp',
      '.go': 'ace/mode/golang',
      '.rs': 'ace/mode/rust',
      '.swift': 'ace/mode/swift',
      '.kt': 'ace/mode/kotlin',
      '.scala': 'ace/mode/scala',
      '.hs': 'ace/mode/haskell',
      '.fs': 'ace/mode/fsharp',
      '.lua': 'ace/mode/lua',
      '.pl': 'ace/mode/perl',
      '.h': 'ace/mode/objectivec',
      '.cs': 'ace/mode/csharp',
      '.vb': 'ace/mode/vbnet',
      '.html': 'ace/mode/html',
      '.xml': 'ace/mode/xml',
      '.css': 'ace/mode/css',
      '.less': 'ace/mode/less',
      '.sass': 'ace/mode/sass',
      '.scss': 'ace/mode/scss',
      '.styl': 'ace/mode/stylus',
      '.haml': 'ace/mode/haml',
      '.pug': 'ace/mode/pug',
      '.ejs': 'ace/mode/ejs',
      '.coffee': 'ace/mode/coffeescript',
      '.ls': 'ace/mode/livescript',
      '.dart': 'ace/mode/dart',
      '.hx': 'ace/mode/haxe',
      '.jl': 'ace/mode/julia',
      '.erl': 'ace/mode/erlang',
      '.ml': 'ace/mode/ocaml',
      '.vala': 'ace/mode/vala',
      '.d': 'ace/mode/d',
      '.json': 'ace/mode/json',
      '.yaml': 'ace/mode/yaml',
      '.sql': 'ace/mode/sql',
      '.md': 'ace/mode/markdown',
      '.tex': 'ace/mode/latex',
      '.glsl': 'ace/mode/glsl',
      '.hbs': 'ace/mode/handlebars',
      '.mustache': 'ace/mode/mustache',
      '.djhtml': 'ace/mode/django',
      '.smarty': 'ace/mode/smarty',
      '.txt': 'ace/mode/text',
      '.diff': 'ace/mode/diff',
      '.adoc': 'ace/mode/asciidoc',
      '.ini': 'ace/mode/ini',
      '.conf': 'ace/mode/apache_conf',
      '.logiql': 'ace/mode/logiql',
      '.rdoc': 'ace/mode/rdoc',
      '.snippet': 'ace/mode/snippet',
      '.feature': 'ace/mode/gherkin',
      '.frontmatter': 'ace/mode/yaml-front-matter',
    };

    function buildLinks(node, path = '') {
      const currentPath = path ? `${path}/${node.text}` : node.text;
      node.a_attr = {
        href: fileEdit + `?file_path=${currentPath}`,
        class: 'js-tree-node'
      };

      if (node.children && node.children.length > 0) {
        node.children.forEach(child => buildLinks(child, currentPath));
      } else {
        node.a_attr = {
          href: fileEdit + `?file_path=${currentPath}`,
          class: 'js-tree-node'
        };
      }
    }
    if (Object.keys(data).length !== 0) {
      data.forEach(folder => buildLinks(folder));
    }
    $('#file-tree').jstree({
      'core' : {
        'data' : data
      }
    });

    $.ajaxSetup({
      headers: {
        'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
      }
    });

    $(document).off('click', '.js-tree-node').on('click', '.js-tree-node', function (event) {
      event.preventDefault();
      var href = $(this).attr('href');
      var file_path = href.split('?')[1].replace('file_path=','');
      $.ajax({
        url: href,
        method: 'GET',
        dataType: 'json',
        success: function(data) {
          if (data.file_data !== null) {
            var file_ext = data.file_ext;
            if (file_ext in extensionToMode) {
              editor.session.setMode(extensionToMode[file_ext]);
            } else {
              editor.session.setMode('ace/mode/text');
            }
            editor.setValue(data.file_data, -1);
            $("#save_file").attr("href", "<%= save_file_path(current_user) %>?file_path=" + encodeURIComponent(file_path));
            $("#file_name").text(file_path.replace('file_path=','').split('/').slice(-1)[0]);
            $("#breadcrumb").text(file_path.replace('file_path=',''));
          }
        },
        error: function(jqXHR, textStatus, errorThrown) {
          if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
            errorMessage = jqXHR.responseJSON.error;
            alert(errorMessage);
          }
        }
      });
    });
  
    $(document).off('click', '#save_file').on('click', '#save_file', function (event) {
      event.preventDefault();
      var href = $(this).attr('href');
      if (href === 'javascript:void(0);') {
        return
      }
      var file_path = href.split('?')[1];
      updated_file_data = editor.getValue();
      $.ajax({
        url: href,
        method: 'POST',
        dataType: 'json',
        data: { updated_file_data: updated_file_data },
        success: function(data) {
          editor.setValue("", -1);
          $("#save_file").attr("href", "javascript:void(0);");
          $("#push-to-git").attr("href", "javascript:void(0);");
          $("#file_name").text("");
          $("#file-breadcrumb").text("");
        },
        error: function(jqXHR, textStatus, errorThrown) {
          if (jqXHR.responseJSON && jqXHR.responseJSON.error) {
            errorMessage = jqXHR.responseJSON.error;
            alert(errorMessage);
          }
        }
      });
    });

    $(document).on('click', '#download-zip', function (event) {
      var href = $(this).attr('href');
      if (href && !href.includes('folder_name')) {
        event.preventDefault();
      }
    });

    $(document).on('click', '#open-workflow-modal', function (event) {
      $('#workflow-modal').removeClass('hidden');
      $('#workflow-modal').addClass('flex');
    });

    $(document).on('click', '#open-upload-zip-modal', function (event) {
      $('#upload-zip-modal').removeClass('hidden');
      $('#upload-zip-modal').addClass('flex');
    });

    $(document).on('click', '#open-github-modal', function (event) {
      $('#github-modal').removeClass('hidden');
      $('#github-modal').addClass('flex');
    });

    $(document).on('click', '#close-workflow-modal-svg, #close-workflow-modal-btn', function (event) {
      $('#workflow-modal').addClass('hidden');
    });

    $(document).on('click', '#close-upload-zip-modal-svg, #close-upload-zip-modal-btn', function (event) {
      $('#upload-zip-modal').addClass('hidden');
    });

    $(document).on('click', '#close-github-modal-svg, #close-github-modal-btn', function (event) {
      $('#github-modal').addClass('hidden');
    });

    $(document).on('click', '#open-folder-link', function (event) {
      editor.destroy();
      editor.container.remove();
    });

    function updatemenu() {
      if (document.getElementById('responsive-menu').checked == true) {
        document.getElementById('menu').style.borderBottomRightRadius = '0';
        document.getElementById('menu').style.borderBottomLeftRadius = '0';
      }else{
        document.getElementById('menu').style.borderRadius = '10px';
      }
    }
  });
</script>