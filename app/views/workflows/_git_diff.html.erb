<div id="git-diff">
  <p class="text-lg text-black font-bold"> Unstaged Changes: </p>
  <%= form_with url: git_push_path(current_user), method: :post, local: true, data: { turbo: true }, class: 'max-w-sm mx-auto' do |form| %>
    <%= form.hidden_field :repo_name, value: @repo_name %>
    <% if @changes.present? %>
      <% @changes.each do |type, files| %>
        <% if files.present? %>
          <div class='pb-4'>
            <p class='pb-4 text-sm font-bold'> <%= type %> <p>
            <% files.each do |file| %>
              <div class='flex items-start mb-5'>
                <%= form.check_box "files[#{file}]", id: "#{file}", class: 'w-4 h-4 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-blue-300 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800' %>
                <%= form.label "#{file}", "#{file}", class: 'px-2 text-sm font-medium text-gray-900 dark:text-gray-300' %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <div class="pb-4">
      <%= form.label :commit_message, 'Commit Message: ' %>
      <%= form.text_field :commit_message, placeholder: 'Enter Your Commit Message', class: 'rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6', required: true %>
    </div>
    <%= form.submit "Commit & Push Changes", class: 'py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700' %>
  <% end %>
</div>