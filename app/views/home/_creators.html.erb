<%= link_to marketplace_creator_path(creator.id), class: "" do %>
 <li class="col-span-1 flex flex-col divide-y-4 divide-black rounded-lg bg-gray-300 text-center hover:border-white border-black border-4 rounded-2xl hover:shadow-[0px_20px_20px_15px_#1a202c] hover:bounceOrig">
  <div class="flex flex-1 flex-col p-8 border-2 border-black">
    <% if creator.profile_picture.attached? %>
      <%= image_tag creator.profile_picture, class: "mx-auto h-32 w-32 flex-shrink-0 rounded-full" %>
    <% else %>
      <img class="mx-auto h-32 w-32 flex-shrink-0 rounded-full" src="https://gitlocker.s3.us-east-2.amazonaws.com/man-standing-holding-laptop-while-showing-programming-language-software.png" alt="no profile picture">
    <% end %>
    <h1 class="mt-6 text-sm font-medium text-gray-900 "><%= creator.name %></h3>
    <dl class="mt-1 flex flex-grow flex-col justify-between">
      <dt class="sr-only">Title</dt>
      <dd class="text-sm text-gray-500">@<%= creator.username %></dd>
        <% if creator.languages.present? && creator.languages.size > 0 && creator.languages[0]&.name != 'not_specified' %>
            <div class="flex flex-row flex-wrap mt-2 items-center justify-start gap-2">
              <% creator.languages.take(3).each do |language| %>
                <p class="text-xs border border-gray-900 rounded px-2 py-1.5 text-black" style="<%= get_color_code(language.name).present? ? "background-color: #{get_color_code(language.name)}; color: white;" : '' %>"><%= language.name %></p>
              <% end %>
            </div>
          <% end %>
         <% if creator.categories.present? && creator.categories.size > 0 && creator.categories[0]&.name != 'not_specified' %>
            <div class="flex flex-row flex-wrap mt-2 items-center justify-start gap-2">
              <% creator.categories.take(3).each do |category| %>
                <p class="text-xs border border-gray-900 rounded px-2 py-1.5 text-black"><%= category.name %></p>
              <% end %>
            </div>
          <% end %>
    </dl>
  </div>
  <div>
    <div class="-mt-px flex divide-x-4 divide-black">
      <div class="flex w-0 flex-1">
        <%= link_to "Coderz Profile", marketplace_creator_path(creator), class: "relative -mr-px inline-flex w-0 flex-1 items-center justify-center gap-x-3 rounded-bl-lg border border-transparent py-4 text-sm font-semibold text-gray-900 hover:bg-blue-500 hover:text-white" %>
        <a href="https://github.com/<%= creator.username %>" target="_blank" class="relative -mr-px inline-flex w-0 flex-1 items-center justify-center gap-x-3 rounded-bl-lg border border-transparent py-4 text-sm font-semibold text-gray-900 hover:bg-orange-500 hover:text-white">
        GitHub Profile
      </a>
      </div>
    </div>
  </div>
</li>
<% end %>
