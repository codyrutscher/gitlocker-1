<html>
<head>
<style>

</style>
</head>
<body>
<%= link_to marketplace_category_path(category.slug), class: "relative aspect-square border-4 border-gray-900 border-black border-4 rounded hover:shadow-[0px_20px_20px_15px_#1158f2] hover:bounceOrig" do %>
  <%= image_tag "categories/#{category.image_name}", class: "h-full w-full aspect-square object-cover object-center rounded", alt: "#{category.image_name} Image" %>
  <div class="absolute rounded-b border-4 bottom-0 flex items-center justify-center right-0 left-0 bg-gradient-to-b from-transparent to-gray-300 ">
    <div id="description" class="w-full flex items-center">
    <p class="p-3 w-full text-center text-sm font-bold text-white"><%= category.products.count %> <%= category.name %> Products</p>
    </div>
  </div>
<% end %>
</body>
</html>
