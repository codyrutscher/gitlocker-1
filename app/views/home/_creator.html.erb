<html>
<head>
<style>


</style>
</head>
<body>
<%= link_to marketplace_creator_path(creator.id), class: "relative flex border-4 border-gray-900 md:min-h-64 flex-col overflow-hidden hover:shadow-[0px_20px_20px_15px_#1158f2] rounded-lg p-6 hover:opacity-75 md:w-56 lg:w-64 xl:w-auto" do %>
  <span aria-hidden="true" class="absolute inset-0">
    <% if creator.profile_picture.attached? %>
      <%= image_tag creator.profile_picture, class: "h-full w-full object-cover object-center", style: "object-fit: contain;" %>
    <% else %>
      <%= image_tag "profile_placeholder.png", class: "h-full w-full object-cover object-center", style: "object-fit: inherit;" %>
    <% end %>
  </span>
  <div class="absolute rounded-b border-4 bottom-0 flex items-center justify-center right-0 left-0">
    <div id="description" class="flex w-full items-center">
    <p class="p-3 w-full text-center text-sm font-bold text-white"><%= creator.username %></p>
    </div>
  </div>
<% end %>
</body>
</html>
