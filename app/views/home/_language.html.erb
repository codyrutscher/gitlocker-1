<%= link_to marketplace_language_path(language.slug), class: "relative aspect-square border border-black border-4 rounded hover:shadow-[0px_20px_20px_15px_#1158f2]" do %>
  <%= image_tag "languages/#{language.image_name}", class: "h-full w-full aspect-square object-cover object-center rounded", alt: "#{language.image_name} Image" %>
  <div class="rounded-b border-4 bottom-0 flex items-center justify-center right-0 left-0 bg-gradient-to-b from-transparent to-gray-300 ">
    <div class="bg-white rounded-3xl flex items-center">
    <p class="p-3 w-full text-center text-sm font-bold text-black"><%= language.name %></p>
    </div>
  </div>
<% end %>
